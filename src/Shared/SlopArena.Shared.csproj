<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>$(MSBuildProjectDirectory)/../../artifacts/Shared/bin/</BaseOutputPath>
    <Nullable>enable</Nullable>
    <NoWarn>IDE0005;CA1031</NoWarn>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>SlopArena.Shared</PackageId>
    <Version>0.1.0</Version>
    <Authors>Binoui</Authors>
    <Description>Shared data types for SlopArena — pure C#, no Unity dependencies</Description>
    <RepositoryUrl>https://github.com/Binoui/SlopArena</RepositoryUrl>
    <!-- Keep standalone .NET outputs complete. Unity's third-party managed
         inputs are versioned separately in Assets/Plugins/NuGet. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Shared uses JSON codecs but has no SignalR or Unity dependency. -->
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>

  <Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(SkipUnityPluginCopy)' != 'true'">
    <!-- NuGet owns Unity's third-party assemblies; do not export that closure
         from Shared. This target never prunes a contributor's plugin folder. -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll"
          DestinationFolder="$(MSBuildProjectDirectory)/../../client/Unity/Assets/Plugins/SlopArena.Shared"
          SkipUnchangedFiles="true" />
    <!-- Debug symbols for Shared only (deps' pdbs are noise in Unity). -->
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
          DestinationFolder="$(MSBuildProjectDirectory)/../../client/Unity/Assets/Plugins/SlopArena.Shared"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
