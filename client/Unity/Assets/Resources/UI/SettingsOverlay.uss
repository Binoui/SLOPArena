.sa-settings-cover {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.94);
    color: rgb(240, 238, 232);
    font-size: 15px;
}

.sa-settings-poster {
    width: 94%;
    max-width: 1060px;
    height: 88%;
    max-height: 780px;
    min-height: 470px;
    padding: 22px 26px;
    background-color: rgb(240, 238, 232);
    /* The shared modal card: ink frame with a hard bottom/right print offset,
       as the frontend MENU and the in-match pause card. */
    border-width: 3px;
    border-right-width: 6px;
    border-bottom-width: 8px;
    border-color: rgb(22, 21, 19);
}

.sa-settings-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}

.sa-settings-title {
    color: rgb(27, 26, 24);
    font-size: 48px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.sa-settings-tabs {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    margin-top: 12px;
    margin-bottom: 14px;
}

.sa-settings-tab {
    min-height: 42px;
    min-width: 115px;
    margin-right: 6px;
    margin-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    font-size: 14px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.sa-settings-tab--selected {
    background-image: none;
    background-color: rgb(255, 204, 34);
    color: rgb(27, 26, 24);
    border-bottom-color: rgb(22, 21, 19);
}

/* Focus and hover never borrow the selected yellow: paper tabs turn ink with a
   yellow frame; the selected tab keeps its yellow and takes a heavier ink frame. */
.sa-settings-tab:hover,
.sa-settings-tab:focus {
    background-color: rgb(27, 26, 24);
    color: rgb(240, 238, 232);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}

.sa-settings-tab--selected:hover,
.sa-settings-tab--selected:focus {
    background-color: rgb(255, 204, 34);
    color: rgb(27, 26, 24);
    border-width: 3px;
    border-bottom-width: 5px;
    border-color: rgb(22, 21, 19);
}

.sa-settings-tab:active { translate: 0 3px; }

.sa-settings-scroll {
    flex-grow: 1;
    min-height: 100px;
    padding-left: 16px;
    padding-right: 10px;
    padding-top: 18px;
    padding-bottom: 12px;
    background-color: rgb(22, 21, 19);
    border-width: 2px;
    border-color: rgb(27, 26, 24);
}

/* A thin scrollbar in the panel's own colours, without Unity's arrow buttons. */
.sa-settings-scroll .unity-scroller--vertical {
    width: 8px;
    margin-left: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.sa-settings-scroll .unity-scroller__low-button,
.sa-settings-scroll .unity-scroller__high-button { display: none; }
.sa-settings-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgb(37, 36, 34);
    border-width: 0;
}
.sa-settings-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgb(123, 120, 114);
    border-width: 0;
}
.sa-settings-scroll .unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(240, 238, 232);
}
.sa-settings-scroll .unity-scroller--vertical .unity-base-slider__dragger-border { border-width: 0; }

.sa-settings-body { color: rgb(240, 238, 232); }
.sa-settings-columns { flex-direction: row; flex-wrap: wrap; }
.sa-settings-column { flex-grow: 1; flex-basis: 330px; min-width: 0; }
.sa-settings-column--first { margin-right: 12px; }

/* Every control sits on the same row: one surface, one label style, centred. */
.sa-settings-row, .sa-settings-binding-row,
.sa-settings-field, .sa-settings-toggle {
    flex-direction: row;
    align-items: center;
    min-height: 54px;
    margin: 0 0 8px 0;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
}

.sa-settings-row-label,
.sa-settings-field .unity-base-field__label,
.sa-settings-toggle .unity-base-field__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 105px;
    margin: 0;
    padding: 0 12px 0 0;
    color: rgb(240, 238, 232);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
}

.sa-settings-slider { width: 38%; min-width: 100px; }
.sa-settings-value {
    color: rgb(255, 204, 34);
    font-size: 14px;
}
.sa-settings-value { width: 52px; -unity-text-align: middle-right; }
.sa-settings-status {
    color: rgb(27, 26, 24);
    font-size: 14px;
}
.sa-settings-binding-current { width: 140px; color: rgb(240, 238, 232); }

.sa-settings-scroll .sa-settings-slider .unity-base-slider__tracker {
    background-image: none;
    background-color: rgb(123, 120, 114);
}
.sa-settings-scroll .sa-settings-slider .unity-base-slider__dragger {
    background-image: none;
    background-color: rgb(255, 204, 34);
    border-color: rgb(22, 21, 19);
}
.sa-settings-scroll .sa-settings-slider:focus .unity-base-slider__dragger {
    border-color: rgb(240, 238, 232);
}

/* Dropdowns: the value field takes the right side, like a slider and its value.
   Unity's theme gives field inputs flex-basis 0, which wins over width; set the
   basis itself. */
.sa-settings-field .unity-base-field__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: 46%;
    min-height: 36px;
    margin: 0;
    padding-left: 10px;
    padding-right: 8px;
    background-color: rgb(22, 21, 19);
    border-width: 2px;
    border-radius: 0;
    border-color: rgb(123, 120, 114);
    color: rgb(240, 238, 232);
}
.sa-settings-field:hover .unity-base-field__input,
.sa-settings-field:focus .unity-base-field__input,
.sa-settings-field .unity-base-field__input:focus { border-color: rgb(255, 204, 34); }
.sa-settings-field .unity-base-field__input .unity-text-element { color: rgb(240, 238, 232); }
.sa-settings-field .unity-base-field__input .unity-base-popup-field__text { color: rgb(240, 238, 232); }
.sa-settings-field .unity-base-popup-field__arrow { -unity-background-image-tint-color: rgb(240, 238, 232); }

/* Toggles: the checkbox sits at the row's right edge, where slider values sit. */
.sa-settings-toggle .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.sa-settings-toggle .unity-toggle__checkmark {
    width: 22px;
    height: 22px;
    background-color: rgb(22, 21, 19);
    border-width: 2px;
    border-color: rgb(123, 120, 114);
    -unity-background-image-tint-color: rgb(27, 26, 24);
}
.sa-settings-toggle:checked .unity-toggle__checkmark {
    background-color: rgb(255, 204, 34);
    border-color: rgb(255, 204, 34);
}
.sa-settings-toggle:hover .unity-toggle__checkmark,
.sa-settings-toggle:focus .unity-toggle__checkmark { border-color: rgb(255, 204, 34); }
.sa-settings-toggle:checked:hover .unity-toggle__checkmark,
.sa-settings-toggle:checked:focus .unity-toggle__checkmark { border-color: rgb(240, 238, 232); }

/* Help notes belong to the row above: same inset, quieter, with room before the next row. */
.sa-settings-note {
    margin: -2px 0 14px 0;
    padding: 0 12px;
    color: rgb(183, 180, 173);
    font-size: 13px;
    white-space: normal;
}

/* Tab-level actions (APPLY DISPLAY, RESET CONTROLS) are buttons, not full-width bars. */
.sa-settings-body .sa-settings-body-action {
    align-self: flex-end;
    min-width: 220px;
    margin-top: 4px;
    margin-bottom: 12px;
}

.sa-settings-status { min-height: 18px; margin-top: 6px; white-space: normal; }
.sa-settings-footer {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-top: 12px;
}
.sa-settings-spacer { flex-grow: 1; }
.sa-settings-body .sa-settings-action {
    min-height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    font-size: 13px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
.sa-settings-body .sa-settings-action:hover,
.sa-settings-body .sa-settings-action:focus {
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}
.sa-settings-body .sa-settings-action:active { translate: 0 3px; }
.sa-settings-body .sa-settings-action:disabled {
    background-image: none;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-color: rgb(123, 120, 114);
}
.sa-settings-footer .sa-settings-action {
    min-height: 44px;
    padding-left: 16px;
    padding-right: 16px;
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    font-size: 13px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
/* On the paper card a focused paper button turns ink with a yellow frame; the
   yellow primary keeps its yellow and takes a heavier ink frame. */
.sa-settings-footer .sa-settings-action:hover,
.sa-settings-footer .sa-settings-action:focus {
    background-image: none;
    background-color: rgb(27, 26, 24);
    color: rgb(240, 238, 232);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}
.sa-settings-footer .sa-settings-action:active { translate: 0 3px; }
.sa-settings-footer .sa-settings-action--primary {
    min-width: 140px;
    background-image: none;
    background-color: rgb(255, 204, 34);
    color: rgb(27, 26, 24);
    border-bottom-color: rgb(22, 21, 19);
}
.sa-settings-footer .sa-settings-action--primary:hover,
.sa-settings-footer .sa-settings-action--primary:focus {
    background-image: none;
    background-color: rgb(255, 204, 34);
    color: rgb(27, 26, 24);
    border-left-width: 4px;
    border-top-width: 4px;
    border-right-width: 4px;
    border-color: rgb(22, 21, 19);
}
.sa-settings-footer .sa-settings-action:disabled {
    background-image: none;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-color: rgb(123, 120, 114);
}

.sa-settings-confirmation {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.9);
}
.sa-settings-confirmation-card {
    width: 90%;
    max-width: 480px;
    padding: 22px;
    background-color: rgb(240, 238, 232);
    border-width: 3px;
    border-right-width: 6px;
    border-bottom-width: 8px;
    border-color: rgb(22, 21, 19);
}
.sa-settings-confirmation-title {
    color: rgb(27, 26, 24);
    font-size: 18px;
    white-space: normal;
}
.sa-settings-confirmation-actions { flex-direction: row; margin-top: 18px; }
.sa-settings-confirmation-actions .sa-settings-action {
    flex-grow: 1;
    margin-right: 8px;
    min-height: 44px;
    padding-left: 12px;
    padding-right: 12px;
    background-image: none;
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-left-width: 2px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 5px;
    border-left-color: rgb(22, 21, 19);
    border-top-color: rgb(22, 21, 19);
    border-right-color: rgb(22, 21, 19);
    border-bottom-color: rgb(22, 21, 19);
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
.sa-settings-confirmation-actions .sa-settings-action:hover,
.sa-settings-confirmation-actions .sa-settings-action:focus {
    background-image: none;
    color: rgb(240, 238, 232);
    background-color: rgb(27, 26, 24);
    border-top-color: rgb(255, 204, 34);
    border-left-color: rgb(255, 204, 34);
    border-right-color: rgb(255, 204, 34);
}
.sa-settings-confirmation-actions .sa-settings-action:active { translate: 0 3px; }
.sa-settings-confirmation-actions .sa-settings-action:disabled {
    background-image: none;
    background-color: rgb(37, 36, 34);
    color: rgb(240, 238, 232);
    border-color: rgb(123, 120, 114);
}

.sa-settings-cover .sa-settings-action:disabled:active {
    translate: 0 0;
}
