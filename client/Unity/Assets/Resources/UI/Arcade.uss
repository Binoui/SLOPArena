.arcade-header {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    padding: 0;
}
.arcade-header .btn-back {
    margin: 0;
    min-height: 48px;
    border-color: rgb(23, 19, 27);
}
.arcade-page-title {
    margin: 0;
    padding: 8px 16px;
    background-color: rgb(240, 238, 232);
    color: rgb(23, 19, 27);
    font-size: 30px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
.arcade-body {
    flex-grow: 1;
    min-height: 0;
    padding-top: 16px;
    padding-bottom: 24px;
}
.arcade-layout {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    align-items: stretch;
}
.arcade-mode-browser {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    min-height: 0;
    margin-right: 24px;
}
.arcade-section-label {
    align-self: flex-start;
    margin: 0;
    padding: 6px 10px;
    background-color: rgb(240, 238, 232);
    color: rgb(23, 19, 27);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
.arcade-mode-gallery {
    flex-grow: 1;
    min-height: 0;
    margin-top: 12px;
}
.arcade-mode-gallery .unity-scroll-view__content-container {
    min-height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    align-content: flex-start;
    justify-content: space-between;
}
.arcade-mode-card {
    width: 48%;
    height: 360px;
    min-width: 0;
    flex-shrink: 0;
    margin: 0 0 16px;
    padding: 0;
    background-color: rgb(23, 19, 27);
    border-width: 3px;
    border-color: rgb(23, 19, 27);
    border-radius: 0;
    color: rgb(23, 19, 27);
}
.arcade-mode-gallery--single .arcade-mode-card {
    width: 100%;
    height: 100%;
    min-height: 320px;
    margin-bottom: 0;
}
.arcade-mode-card--selected {
    border-color: rgb(255, 204, 34);
}
.arcade-mode-card:hover,
.arcade-mode-card:focus {
    border-color: rgb(224, 92, 42);
}
.arcade-mode-art {
    flex-grow: 1;
    min-height: 120px;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}
.arcade-mode-art--slopball {
    background-image: url("../../UI/Arcade/SlopballPoster.png");
}
.arcade-mode-caption {
    flex-shrink: 0;
    padding: 16px 20px;
    background-color: rgb(240, 238, 232);
}
.arcade-mode-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.arcade-mode-title {
    margin: 0;
    color: rgb(23, 19, 27);
    min-width: 0;
    flex-shrink: 1;
    font-size: 26px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    letter-spacing: -1px;
    white-space: normal;
}
.arcade-mode-gallery--single .arcade-mode-title { font-size: 38px; }
.arcade-mode-check {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-left: 12px;
    background-image: url("../../UI/SelectionCheck.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(23, 19, 27);
    display: none;
}
.arcade-mode-card--selected .arcade-mode-check { display: flex; }
.arcade-mode-rule {
    margin: 6px 0 0;
    color: rgb(23, 19, 27);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: upper-left;
}
.arcade-setup {
    width: 34%;
    min-width: 340px;
    max-width: 520px;
    min-height: 0;
    flex-shrink: 0;
    padding: 20px;
    background-color: rgb(240, 238, 232);
    color: rgb(23, 19, 27);
    border-width: 2px;
    border-color: rgb(23, 19, 27);
}
.arcade-selected-mode {
    margin: 0 0 12px;
    font-size: 22px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}
.arcade-setup .arcade-section-label { padding: 0; }
.arcade-roster {
    flex-grow: 1;
    min-height: 0;
    margin-top: 12px;
}
.arcade-fighters {
    flex-grow: 1;
    min-height: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    padding: 0;
}
.arcade-fighters .char-card {
    width: 48%;
    min-width: 0;
    min-height: 0;
    height: 48%;
    flex-shrink: 0;
    margin: 0;
    border-width: 3px;
    border-color: rgb(23, 19, 27);
    translate: 0 0;
}
.arcade-fighters .char-card--selected { border-color: rgb(255, 204, 34); }
.arcade-fighters .char-card:hover,
.arcade-fighters .char-card:focus,
.arcade-fighters .char-card--selected:hover,
.arcade-fighters .char-card--selected:focus {
    border-width: 3px;
    border-color: rgb(224, 92, 42);
    translate: 0 0;
}
.arcade-fighters .char-portrait {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
.arcade-fighters .char-card-name {
    min-height: 28px;
    height: 28px;
    padding-left: 10px;
    padding-right: 28px;
    border-top-width: 2px;
    font-size: 13px;
}
.arcade-fighters .char-card-check {
    width: 14px;
    height: 14px;
    right: 8px;
    bottom: 10px;
}
.arcade-record-panel {
    flex-shrink: 0;
    margin-top: 12px;
    padding-top: 12px;
    border-top-width: 1px;
    border-top-color: rgb(98, 92, 107);
}
.arcade-best-fighter {
    margin: 0 0 4px;
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
}
.arcade-best {
    margin: 0;
    font-size: 24px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    white-space: normal;
}
.arcade-record-panel .unity-foldout__toggle {
    min-height: 24px;
    margin-top: 8px;
    font-size: 12px;
}
.arcade-archive { max-height: 72px; }
.arcade-archive Label { font-size: 12px; }
.arcade-feedback {
    margin-top: 8px;
    font-size: 13px;
    white-space: normal;
}
.arcade-launch-row {
    flex-shrink: 0;
    margin-top: 16px;
}
.arcade-launch-row .btn-primary {
    width: 100%;
    min-width: 0;
    min-height: 56px;
    margin: 0;
    font-size: 20px;
}
.frontend-shell--compact .arcade-page-title { font-size: 26px; }
.frontend-shell--compact .arcade-body { padding-top: 12px; padding-bottom: 16px; }
.frontend-shell--compact .arcade-mode-browser { margin-right: 16px; }
.frontend-shell--compact .arcade-mode-gallery { margin-top: 8px; }
.frontend-shell--compact .arcade-mode-card { width: 100%; height: 300px; }
.frontend-shell--compact .arcade-mode-gallery--single .arcade-mode-card {
    height: 100%;
    min-height: 240px;
}
.frontend-shell--compact .arcade-mode-caption { padding: 12px 16px; }
.frontend-shell--compact .arcade-mode-title { font-size: 28px; }
.frontend-shell--compact .arcade-mode-rule { font-size: 13px; }
.frontend-shell--compact .arcade-setup {
    width: 40%;
    min-width: 300px;
    max-width: 420px;
    padding: 14px;
}
.frontend-shell--compact .arcade-selected-mode { font-size: 18px; margin-bottom: 10px; }
.frontend-shell--compact .arcade-fighters .char-card-name { min-height: 24px; height: 24px; font-size: 12px; }
.frontend-shell--compact .arcade-roster { margin-top: 10px; }
.frontend-shell--compact .arcade-record-panel { margin-top: 8px; padding-top: 8px; }
.frontend-shell--compact .arcade-best { font-size: 20px; }
.frontend-shell--compact .arcade-archive { max-height: 48px; }
.frontend-shell--compact .arcade-launch-row { margin-top: 12px; }
.frontend-shell--compact .arcade-launch-row .btn-primary { min-height: 48px; font-size: 17px; }

.slopball-live { position: absolute; right: 18px; top: 76px; width: 265px; padding: 12px; background-color: rgba(13, 13, 20, 0.86); color: rgb(240, 238, 232); border-left-width: 4px; border-left-color: rgb(255, 204, 34); }
.arcade-eyebrow { font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; }
.slopball-count { white-space: normal; font-size: 16px; margin-top: 4px; margin-bottom: 8px; }
.slopball-cue { font-size: 14px; white-space: normal; margin-top: 6px; margin-bottom: 8px; }
.slopball-controls { font-size: 10px; margin-top: 10px; }
.course-retry-hold { display: none; height: 4px; margin-top: 6px; background-color: rgba(240, 238, 232, 0.18); }
.course-retry-hold-fill { height: 100%; width: 0; background-color: rgb(255, 204, 34); }
.course-pips { flex-direction: row; margin-top: -2px; margin-bottom: 8px; padding-left: 2px; }
.course-pip-group { flex-direction: row; margin-right: 7px; }
.course-pip { width: 7px; height: 7px; margin-right: 3px; rotate: 45deg; border-width: 1px; border-color: rgba(240, 238, 232, 0.55); transition-property: background-color, border-color; transition-duration: 0.2s; }
.course-pip--broken { background-color: rgb(255, 204, 34); border-color: rgb(255, 204, 34); }
.course-pip--missed { background-color: rgba(255, 112, 103, 0.3); border-color: rgb(255, 112, 103); }
.course-checkpoint--warning { color: rgb(255, 122, 92); }
.course-toast { display: none; position: absolute; right: 100%; top: 150px; width: 250px; margin-right: 12px; padding: 9px 12px; background-color: rgba(13, 13, 20, 0.92); border-left-width: 4px; border-left-color: rgb(47, 193, 170); }
.course-toast-title { font-size: 15px; -unity-font-style: bold; color: rgb(120, 236, 214); white-space: nowrap; }
.course-toast-line { font-size: 12px; color: rgb(240, 238, 232); white-space: normal; margin-top: 2px; }
.course-toast--warning { border-left-color: rgb(210, 58, 44); }
.course-toast--warning .course-toast-title { color: rgb(255, 122, 92); }
.course-count-pop { position: absolute; translate: -50% -50%; font-size: 34px; color: rgb(255, 246, 222); -unity-font-definition: url("../../Fonts/ArchivoBlack.asset"); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(43, 18, 12); text-shadow: 3px 3px 0px rgb(200, 129, 26); white-space: nowrap; }
.course-edge-marker { position: absolute; width: 18px; height: 18px; translate: -50% -50%; rotate: 45deg; background-color: rgb(210, 58, 44); border-width: 2px; border-color: rgb(255, 246, 222); }
.slopball-streak-toast {
    position: absolute;
    right: 100%;
    top: 28px;
    margin-right: 14px;
    padding: 9px 14px;
    background-color: rgba(13, 13, 20, 0.94);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 204, 34);
    color: rgb(255, 220, 92);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: nowrap;
}
.slopball-streak-toast--dropped {
    border-bottom-color: rgb(255, 112, 103);
    color: rgb(255, 154, 145);
}

.arcade-mode-art--course { background-color: rgb(46, 76, 65); justify-content: center; align-items: center; padding: 16px; }
.course-card-route { color: rgb(244, 232, 190); white-space: normal; font-size: 22px; -unity-font-style: bold; -unity-text-align: middle-center; }
.course-time { font-size: 30px; color: rgb(255, 204, 34); -unity-font-style: bold; margin-top: 8px; margin-bottom: 8px; }
.course-results { position: absolute; left: 25%; right: 25%; top: 24%; padding: 28px; background-color: rgb(23, 19, 27); color: rgb(240, 238, 232); border-top-width: 5px; border-top-color: rgb(255, 204, 34); }
.course-results .arcade-mode-title { color: rgb(240, 238, 232); }
.course-actions { flex-direction: row; margin-top: 16px; }
.course-actions Button { flex-grow: 1; margin-right: 8px; min-height: 52px; font-size: 18px; -unity-font-style: bold; color: rgb(23, 19, 27); border-width: 2px; border-color: rgb(23, 19, 27); border-radius: 0; }
.course-actions .btn-primary { background-color: rgb(255, 204, 34); }
.course-actions .btn-secondary { background-color: rgb(240, 238, 232); }
.course-actions Button:hover, .course-actions Button:focus { border-color: rgb(224, 92, 42); }
#arcade-course-tips { margin-top: 10px; margin-bottom: 10px; }
