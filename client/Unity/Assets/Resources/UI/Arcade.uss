.arcade-mode-card {
    width: 48%;
    height: 360px;
    min-width: 0;
    flex-shrink: 0;
    margin: 0 0 16px;
    padding: 0;
    background-color: rgb(27, 26, 24);
    border-width: 3px;
    border-color: rgb(27, 26, 24);
    border-radius: 0;
    color: rgb(27, 26, 24);
}
.arcade-mode-card--selected {
    border-color: rgb(255, 204, 34);
}
.arcade-mode-card:hover,
.arcade-mode-card:focus {
    border-color: rgb(255, 204, 34);
}
.arcade-mode-art {
    flex-grow: 1;
    min-height: 120px;
    background-position: center;
    -unity-background-scale-mode: scale-to-fit;
}
.arcade-mode-art--slopball {
    background-image: url("../../UI/Arcade/SlopballPoster.png");
}
.arcade-mode-caption {
    flex-shrink: 0;
    padding: 16px 20px;
    background-color: rgb(240, 238, 232);
}
.arcade-mode-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}
.arcade-mode-title {
    margin: 0;
    color: rgb(27, 26, 24);
    min-width: 0;
    flex-shrink: 1;
    font-size: 26px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    letter-spacing: -1px;
    white-space: normal;
}
.arcade-mode-check {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    margin-left: 12px;
    background-image: url("../../UI/SelectionCheck.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(27, 26, 24);
    display: none;
}
.arcade-mode-card--selected .arcade-mode-check { display: flex; }
.arcade-mode-rule {
    margin: 6px 0 0;
    color: rgb(27, 26, 24);
    font-size: 15px;
    white-space: normal;
    -unity-text-align: upper-left;
}
.frontend-shell--compact .arcade-mode-card { width: 100%; height: 300px; }
.frontend-shell--compact .arcade-mode-caption { padding: 12px 16px; }
.frontend-shell--compact .arcade-mode-title { font-size: 28px; }
.frontend-shell--compact .arcade-mode-rule { font-size: 13px; }
.arcade-mode-art--course {
    background-image: url("../../UI/Arcade/CoursesPoster.png");
}
.course-results .arcade-mode-title { color: rgb(240, 238, 232); }
.mayhem-pick { flex-grow: 1; margin: 0; padding: 0; border-width: 0; background-color: transparent; flex-direction: column; }
.arcade-mode-art--mayhem { background-image: url("Stages/manki_mayhem.png"); -unity-background-scale-mode: scale-and-crop; }
.mayhem-rules { flex-direction: row; align-items: center; padding: 8px 12px; background-color: rgb(240, 238, 232); }
.mayhem-rules .arcade-mode-rule { margin-right: 12px; font-size: 12px; }
.mayhem-rules .selection-target-button { flex-grow: 1; min-width: 64px; }

.slopball-live { position: absolute; right: 18px; top: 76px; width: 265px; padding: 12px; background-color: rgba(22, 21, 19, 0.86); color: rgb(240, 238, 232); border-left-width: 4px; border-left-color: rgb(255, 204, 34); }
.arcade-eyebrow { font-size: 12px; -unity-font-style: bold; letter-spacing: 1px; }
.slopball-count { white-space: normal; font-size: 16px; margin-top: 4px; margin-bottom: 8px; }
.slopball-cue { font-size: 14px; white-space: normal; margin-top: 6px; margin-bottom: 8px; }
.slopball-controls { font-size: 10px; margin-top: 10px; }
.course-retry-hold { display: none; height: 4px; margin-top: 6px; background-color: rgba(240, 238, 232, 0.18); }
.course-retry-hold-fill { height: 100%; width: 0; background-color: rgb(255, 204, 34); }
.course-pips { flex-direction: row; margin-top: -2px; margin-bottom: 8px; padding-left: 2px; }
.course-pip-group { flex-direction: row; margin-right: 7px; }
.course-pip { width: 7px; height: 7px; margin-right: 3px; rotate: 45deg; border-width: 1px; border-color: rgba(240, 238, 232, 0.55); transition-property: background-color, border-color; transition-duration: 0.2s; }
.course-pip--broken { background-color: rgb(255, 204, 34); border-color: rgb(255, 204, 34); }
.course-pip--missed { background-color: rgba(255, 112, 103, 0.3); border-color: rgb(255, 112, 103); }
.course-checkpoint--warning { color: rgb(255, 122, 92); }
/* Toasts are small flyer cards taped beside the panel (the stock slip's look): Paper, Ink frame, a hard
   Ink shadow from the thick right/bottom edges and a jade (clear) or orange (warning) misprint title. */
.course-toast { display: none; position: absolute; right: 100%; top: 150px; width: 300px; margin-right: 18px; padding: 10px 14px 12px 14px; background-color: rgb(240, 238, 232); border-width: 3px; border-right-width: 8px; border-bottom-width: 8px; border-color: rgb(27, 26, 24); rotate: -3deg; }
.course-toast-tape { position: absolute; left: -16px; top: -8px; width: 52px; height: 16px; background-color: rgba(255, 204, 34, 0.92); border-width: 1px; border-color: rgba(27, 26, 24, 0.35); rotate: -28deg; }
.course-toast-title { font-size: 21px; color: rgb(27, 26, 24); -unity-font-definition: url("../../Fonts/ArchivoBlack.asset"); text-shadow: 2px 2px 0px rgb(47, 193, 170); white-space: nowrap; }
.course-toast-line { font-size: 13px; color: rgb(27, 26, 24); -unity-font-style: bold; white-space: normal; margin-top: 3px; }
.course-toast--warning .course-toast-title { color: rgb(27, 26, 24); text-shadow: 2px 2px 0px rgb(224, 92, 42); }
.course-count-pop { position: absolute; translate: -50% -50%; font-size: 34px; color: rgb(255, 246, 222); -unity-font-definition: url("../../Fonts/ArchivoBlack.asset"); -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(43, 18, 12); text-shadow: 3px 3px 0px rgb(200, 129, 26); white-space: nowrap; }
.course-count-pop--hit { font-size: 24px; color: rgb(255, 204, 34); text-shadow: 2px 2px 0px rgb(214, 59, 47); }
.course-edge-marker { position: absolute; width: 18px; height: 18px; translate: -50% -50%; rotate: 45deg; background-color: rgb(210, 58, 44); border-width: 2px; border-color: rgb(255, 246, 222); }
.slopball-streak-toast {
    position: absolute;
    right: 100%;
    top: 28px;
    margin-right: 14px;
    padding: 9px 14px;
    background-color: rgba(22, 21, 19, 0.94);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 204, 34);
    color: rgb(255, 220, 92);
    font-size: 20px;
    -unity-font-style: bold;
    white-space: nowrap;
}
.slopball-streak-toast--dropped {
    border-bottom-color: rgb(255, 112, 103);
    color: rgb(255, 154, 145);
}

.course-time { font-size: 30px; color: rgb(255, 204, 34); -unity-font-style: bold; margin-top: 8px; margin-bottom: 8px; }
.course-results { position: absolute; left: 25%; right: 25%; top: 24%; padding: 28px; background-color: rgb(27, 26, 24); color: rgb(240, 238, 232); border-top-width: 5px; border-top-color: rgb(255, 204, 34); }
.course-results .arcade-mode-title { color: rgb(240, 238, 232); }
.course-actions { flex-direction: row; margin-top: 16px; }
.course-actions Button { flex-grow: 1; margin-right: 8px; min-height: 52px; font-size: 18px; -unity-font-style: bold; color: rgb(27, 26, 24); border-width: 2px; border-color: rgb(27, 26, 24); border-radius: 0; }
.course-actions .btn-primary { background-color: rgb(255, 204, 34); }
.course-actions .btn-secondary { background-color: rgb(240, 238, 232); }
.course-actions Button:hover, .course-actions Button:focus { border-color: rgb(255, 204, 34); border-width: 3px; }
.course-actions .btn-primary:hover, .course-actions .btn-primary:focus { border-color: rgb(240, 238, 232); }
/* MOVEMENT TIPS: a themed checkbox with a utility label, not Unity's default. */
#arcade-course-tips { margin: 10px 0; }
#arcade-course-tips .unity-toggle__input { flex-direction: row; align-items: center; }
#arcade-course-tips .unity-toggle__checkmark {
    width: 20px;
    height: 20px;
    background-color: rgb(255, 255, 255);
    border-width: 2px;
    border-color: rgb(27, 26, 24);
    -unity-background-image-tint-color: rgb(27, 26, 24);
}
#arcade-course-tips:checked .unity-toggle__checkmark { background-color: rgb(255, 204, 34); }
#arcade-course-tips:hover .unity-toggle__checkmark,
#arcade-course-tips:focus .unity-toggle__checkmark { border-width: 3px; }
#arcade-course-tips .unity-toggle__text {
    margin-left: 8px;
    color: rgb(27, 26, 24);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

/* Online courses share the Solo course panel and add the other runners' progress. */
.stage-course-options { flex-direction: column; width: 100%; margin-top: 12px; }
.stage-course-row { flex-direction: row; align-items: center; margin-bottom: 8px; }
.stage-course-row > Label { flex-grow: 1; color: rgb(235, 224, 199); font-size: 18px; }
.course-online-roster { margin-top: 12px; padding-top: 8px; border-top-width: 1px; border-top-color: rgba(235, 224, 199, .3); }
.course-online-player { border-left-width: 4px; padding-left: 8px; margin-bottom: 10px; }
.course-online-player > Label { color: rgb(235, 224, 199); font-size: 16px; }
.course-online-player .course-pips { flex-wrap: wrap; }

.course-live--online { right: 18px; top: 76px; width: 320px; }
