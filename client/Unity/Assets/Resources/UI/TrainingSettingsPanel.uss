.ts-panel {
    width: 300px;
    max-height: 100%;
    min-height: 0;
    margin-top: 36px;
    flex-shrink: 1;
    padding: 12px 14px 10px 14px;
    flex-direction: column;
    background-color: rgba(27, 26, 24, 0.94);
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    border-bottom-color: #7b7872;
}

.ts-panel:disabled { opacity: 1; }

.ts-movement-summary {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffcc22;
    white-space: normal;
    margin-top: 4px;
}

.ts-panel--compact {
    border-bottom-color: #ffcc22;
}

.ts-panel--compact .ts-heading {
    margin-bottom: 0;
}

.ts-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ts-summary-mode {
    margin-left: 8px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #ffcc22;
}

.ts-panel--editing {
    border-color: #ffcc22;
    background-color: rgba(27, 26, 24, 0.98);
}

.ts-heading {
    flex-shrink: 0;
    margin-bottom: 10px;
}

.ts-title {
    font-size: 20px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #f0eee8;
}

.ts-hint {
    font-size: 10px;
    color: #b7b4ad;
    margin-top: 3px;
}

.ts-panel--editing .ts-hint { color: #ffcc22; }

.ts-scroll {
    min-height: 0;
    flex-shrink: 1;
}

.ts-section {
    flex-shrink: 0;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #484640;
}

.ts-label {
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: #b7b4ad;
    margin-bottom: 6px;
}

.ts-description {
    font-size: 12px;
    color: #dad7d0;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 2px;
}

.ts-damage-heading {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.ts-damage {
    font-size: 22px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #ffcc22;
}

.ts-btn-row {
    flex-direction: row;
}

.ts-btn {
    height: 30px;
    padding-left: 6px;
    padding-right: 6px;
    margin-right: 4px;
    margin-bottom: 4px;
    font-size: 11px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #1b1a18;
    background-color: #f0eee8;
    border-width: 1px;
    border-color: #161513;
    border-bottom-width: 3px;
    -unity-text-align: middle-center;
}

.ts-grow,
.ts-mode-btn {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

/* On this dark panel a focused button keeps its fill and gains a yellow frame;
   turning it ink would sink it into the panel. */
.ts-btn:hover,
.ts-btn:focus {
    background-color: #ffffff;
    color: #1b1a18;
    border-width: 2px;
    border-bottom-width: 3px;
    border-color: #ffcc22;
}

.ts-btn.active,
.ts-btn.active:disabled {
    background-color: #ffcc22;
    color: #1b1a18;
    border-color: #161513;
}

.ts-btn.active:hover,
.ts-btn.active:focus {
    border-width: 2px;
    border-bottom-width: 3px;
    border-color: #f0eee8;
}
.ts-btn:active { translate: 0 2px; }

.ts-btn:disabled {
    opacity: 1;
    background-color: #dad7d0;
    color: #68655f;
    border-color: #161513;
    translate: 0 0;
}

.ts-panel--editing .ts-btn:disabled {
    background-color: #252422;
    color: #7b7872;
}

.ts-reset-all { margin-right: 4px; }

/* Label on the left, checkbox at the right edge, both centred on one row. */
.ts-toggle {
    flex-direction: row;
    align-items: center;
    min-height: 28px;
    margin: 2px 0 4px 0;
    font-size: 12px;
    color: #f0eee8;
    flex-shrink: 0;
}

.ts-toggle .unity-base-field__label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0 8px 0 0;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    white-space: normal;
    color: #f0eee8;
}

.ts-toggle .unity-toggle__input {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ts-toggle .unity-toggle__checkmark {
    width: 18px;
    height: 18px;
    background-color: #161513;
    border-width: 2px;
    border-color: #7b7872;
    -unity-background-image-tint-color: #1b1a18;
}

.ts-toggle:hover .unity-toggle__checkmark,
.ts-toggle:focus .unity-toggle__checkmark { border-color: #ffcc22; }
.ts-toggle:checked .unity-toggle__checkmark {
    background-color: #ffcc22;
    border-color: #ffcc22;
}
.ts-toggle:checked:hover .unity-toggle__checkmark,
.ts-toggle:checked:focus .unity-toggle__checkmark { border-color: #f0eee8; }

/* Thin scrollbar in the panel's colours, without Unity's arrow buttons. */
.ts-scroll .unity-scroller--vertical {
    width: 6px;
    margin-left: 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.ts-scroll .unity-scroller__low-button,
.ts-scroll .unity-scroller__high-button { display: none; }
.ts-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: #252422;
    border-width: 0;
}
.ts-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: #7b7872;
    border-width: 0;
}
.ts-scroll .unity-scroller--vertical .unity-base-slider__dragger-border { border-width: 0; }

