<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="TrainingSettingsPanel.uss" />
    <ui:VisualElement name="ts-panel" class="ts-panel">
        <ui:VisualElement class="ts-heading">
            <ui:VisualElement class="ts-title-row">
                <ui:Label class="ts-title" text="TRAINING" />
                <ui:Label name="ts-summary-mode" class="ts-summary-mode" text="IDLE" />
            </ui:VisualElement>
            <ui:Label name="ts-input-hint" class="ts-hint" text="ESC / START · ADJUST TRAINING" />
        </ui:VisualElement>
        <ui:ScrollView name="ts-scroll" class="ts-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto">
            <ui:VisualElement class="ts-section">
                <ui:Label class="ts-label" text="BEHAVIOR" />
                <ui:VisualElement class="ts-btn-row">
                    <ui:Button name="mode-idle" class="ts-btn ts-mode-btn" text="IDLE" />
                    <ui:Button name="mode-attack" class="ts-btn ts-mode-btn" text="ATTACK" />
                </ui:VisualElement>
                <ui:VisualElement class="ts-btn-row">
                    <ui:Button name="mode-shield" class="ts-btn ts-mode-btn" text="SHIELD" />
                    <ui:Button name="mode-avoid" class="ts-btn ts-mode-btn" text="AVOID" />
                </ui:VisualElement>
                <ui:Label name="npc-mode-description" class="ts-description" text="Stands still. Practice hits and combos." />
            </ui:VisualElement>
            <ui:VisualElement name="difficulty-section" class="ts-section">
                <ui:Label class="ts-label" text="DIFFICULTY" />
                <ui:VisualElement class="ts-btn-row">
                    <ui:Button name="difficulty-easy" class="ts-btn ts-grow" text="EASY" />
                    <ui:Button name="difficulty-normal" class="ts-btn ts-grow" text="NORMAL" />
                    <ui:Button name="difficulty-hard" class="ts-btn ts-grow" text="HARD" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="ts-section">
                <ui:VisualElement class="ts-damage-heading">
                    <ui:Label class="ts-label" text="CPU DAMAGE" />
                    <ui:Label name="npc-damage-label" class="ts-damage" text="0%" />
                </ui:VisualElement>
                <ui:VisualElement class="ts-btn-row">
                    <ui:Button name="dmg-minus" class="ts-btn ts-grow" text="−10%" />
                    <ui:Button name="dmg-plus" class="ts-btn ts-grow" text="+10%" />
                    <ui:Button name="dmg-reset" class="ts-btn ts-grow" text="ZERO" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="ts-section">
                <ui:Label class="ts-label" text="RESET ALL FIGHTERS" />
                <ui:VisualElement class="ts-btn-row">
                    <ui:Button name="reset-damage" class="ts-btn ts-grow" text="DAMAGE" tooltip="Set player and all CPU damage to 0%. Keep positions." />
                    <ui:Button name="reset-position" class="ts-btn ts-grow" text="POSITION" tooltip="Return all fighters to their spawns. Keep damage." />
                </ui:VisualElement>
                <ui:Button name="reset-all" class="ts-btn ts-reset-all" text="RESET BOTH" tooltip="Return all fighters to their spawns and set damage to 0%." />
            </ui:VisualElement>
            <ui:Toggle name="no-cd-toggle" class="ts-toggle" label="No player ability cooldowns" />
            <ui:Toggle name="show-during-play" class="ts-toggle" label="Keep controls visible during play" value="false" tooltip="Pause always expands the controls. During play a compact behavior readout remains visible." />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
