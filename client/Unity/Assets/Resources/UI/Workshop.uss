#workshop-screen { font-size: 20px; }
#workshop-screen Label { white-space: normal; margin-bottom: 8px; }
#workshop-screen Button {
    background-color: rgb(240, 238, 232);
    color: rgb(27, 26, 24);
    border-color: rgb(123, 120, 114);
    border-width: 2px;
    border-radius: 0;
    font-size: 18px;
    padding-left: 12px;
    padding-right: 12px;
}
#workshop-screen Button:focus, #workshop-screen Button:hover {
    background-color: rgb(27, 26, 24);
    color: rgb(255, 204, 34);
    border-color: rgb(255, 204, 34);
}
#workshop-screen .unity-base-text-field__input,
#workshop-screen .unity-base-popup-field__input {
    color: rgb(27, 26, 24);
    background-color: rgb(240, 238, 232);
    font-size: 18px;
}
#workshop-screen .unity-base-field__label { min-width: 140px; color: rgb(240, 238, 232); }
#workshop-screen .unity-toggle__label { color: rgb(240, 238, 232); }
#workshop-screen Button.workshop-tab--selected {
    background-color: rgb(27, 26, 24);
    color: rgb(255, 204, 34);
    border-color: rgb(255, 204, 34);
}
