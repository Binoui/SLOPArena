:root {
    --chat-ink: rgb(27, 26, 24);
    --chat-deep-ink: rgb(22, 21, 19);
    --chat-paper: rgb(240, 238, 232);
    --chat-acid: rgb(255, 204, 34);
    --chat-orange: rgb(240, 91, 53);
    --chat-green: rgb(117, 230, 165);
    --chat-muted: rgb(168, 164, 156);
    --chat-border: rgb(123, 120, 114);
    --chat-rule: rgb(74, 71, 65);
    --chat-surface: rgb(37, 36, 34);
}

/* The presenter fills its host: the shell's social cell, or the whole HUD. */
.chat-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: var(--chat-paper);
}

/* Explicit Page/Social region-switch affordance (issue #215). Sits at the
   bottom-left of the attached surface, opposite the chat strip. Text is set
   by FrontendFocusRouter: the region the switch reaches. */
.chat-region-hint {
    display: none;
    position: absolute;
    left: 16px;
    bottom: 12px;
    padding: 4px 9px;
    background-color: rgba(22, 21, 19, 0.96);
    border-left-width: 3px;
    border-left-color: var(--chat-acid);
    color: var(--chat-muted);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    white-space: nowrap;
}

/* ── Shared message line: chip, name, then text in its own wrapping column ── */

.chat-row {
    flex-direction: row;
    align-items: flex-start;
    margin-bottom: 6px;
}

.chat-row__chip {
    flex-shrink: 0;
    min-width: 54px;
    margin: 2px 8px 0 0;
    padding: 2px 4px 1px 4px;
    border-width: 1px;
    border-color: rgb(93, 90, 85);
    color: var(--chat-muted);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-row__chip--room {
    background-color: var(--chat-paper);
    border-color: var(--chat-paper);
    color: var(--chat-ink);
}

.chat-row__chip--dm {
    background-color: var(--chat-orange);
    border-color: var(--chat-orange);
    color: var(--chat-ink);
}

.chat-row__name {
    flex-shrink: 0;
    margin: 0 7px 0 0;
    padding: 0;
    white-space: nowrap;
    color: var(--chat-paper);
    font-size: 14px;
    -unity-font-style: bold;
}

.chat-row__name--you { color: var(--chat-acid); }

.chat-row__to {
    flex-shrink: 0;
    margin: 3px 7px 0 0;
    color: var(--chat-muted);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
    white-space: nowrap;
}

.chat-row__text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--chat-paper);
    font-size: 14px;
    white-space: normal;
}

.chat-row--system .chat-row__text {
    color: var(--chat-orange);
    font-size: 12px;
}

/* ── Gameplay: ticker lane, reply hint and one-line composer ───────────── */

.chat-lane {
    display: none;
    position: absolute;
    left: 24px;
    bottom: 94px;
    width: 620px;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-end;
}

.chat-root--gameplay .chat-lane { display: flex; }

.chat-ticker {
    flex-direction: column;
    align-items: flex-start;
}

.chat-line {
    max-width: 560px;
    margin: 4px 0 0 0;
    padding: 5px 10px 6px 8px;
    background-color: rgba(22, 21, 19, 0.88);
}

.chat-line .chat-row__name,
.chat-line .chat-row__text { font-size: 15px; }

/* The lane shrinks to its lines: let the text size itself, then wrap at the line's max width. */
.chat-line .chat-row__text {
    flex-grow: 0;
    flex-basis: auto;
}

.chat-hint {
    display: none;
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.chat-hint--visible { display: flex; }

.chat-hint__keys {
    padding: 4px 8px;
    background-color: rgba(22, 21, 19, 0.72);
    color: rgba(240, 238, 232, 0.78);
    font-size: 10px;
    letter-spacing: 1.5px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
    white-space: nowrap;
}

.chat-hint__dm {
    display: none;
    margin-left: 6px;
    padding: 3px 6px 2px 6px;
    background-color: var(--chat-orange);
    color: var(--chat-ink);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.chat-hint__dm--visible { display: flex; }

.chat-lane-compose {
    display: none;
    margin-top: 6px;
}

.chat-lane-compose--open { display: flex; }

/* ── Composer: shared by the menu dock and the gameplay line ─────────────── */

.chat-compose {
    min-height: 40px;
    flex-direction: row;
    align-items: stretch;
    border-width: 1px;
    border-color: var(--chat-paper);
    background-color: var(--chat-deep-ink);
}

.chat-root--gameplay .chat-compose {
    width: 600px;
    min-height: 42px;
    border-width: 2px;
    background-color: rgba(22, 21, 19, 0.97);
}

.chat-to {
    flex-shrink: 0;
    max-width: 180px;
    margin: 0;
    padding: 0 11px;
    border-width: 0;
    border-radius: 0;
    background-color: var(--chat-acid);
    color: var(--chat-ink);
    font-size: 12px;
    letter-spacing: 0.6px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-to:hover,
.chat-to:focus { background-color: rgb(255, 220, 92); }

.chat-root--gameplay .chat-to { font-size: 13px; }

.chat-draft {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0 4px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--chat-paper);
    font-size: 15px;
}

.chat-draft .unity-base-text-field__input {
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--chat-paper);
    --unity-cursor-color: var(--chat-acid);
    -unity-text-align: middle-left;
}

.chat-root--gameplay .chat-draft { font-size: 16px; }

.chat-draft .unity-base-text-field__input--placeholder { color: rgb(125, 122, 116); }

.chat-keys {
    display: none;
    flex-shrink: 0;
    padding: 0 10px 0 6px;
    color: var(--chat-muted);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-right;
    white-space: nowrap;
}

.chat-root--gameplay .chat-keys { display: flex; }
.chat-root--gameplay #chat-send { display: none; }

/* ── Menu: open dock ─────────────────────────────────────────────────────── */

.chat-panel {
    display: none;
    flex-grow: 1;
    min-height: 0;
    position: relative;
    flex-direction: column;
    background-color: var(--chat-deep-ink);
    border-width: 2px;
    border-color: var(--chat-paper);
}

.chat-head {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 6px 66px 6px 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--chat-rule);
}

.chat-filter {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    margin: 0 5px 0 0;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 0;
    border-color: var(--chat-ink);
    background-color: var(--chat-paper);
}

.chat-filter__name {
    margin: 0;
    padding: 0;
    color: var(--chat-ink);
    font-size: 11px;
    letter-spacing: 0.5px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.chat-filter__count {
    display: none;
    min-width: 15px;
    margin: 0 0 0 5px;
    padding: 2px 3px 1px 3px;
    background-color: var(--chat-orange);
    color: var(--chat-ink);
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.chat-filter__count--visible { display: flex; }

.chat-filter--active { background-color: var(--chat-acid); }

.chat-filter:hover,
.chat-filter:focus { border-color: var(--chat-acid); }

.chat-filter:disabled { opacity: 0.45; }

.chat-head__spacer { flex-grow: 1; }

.chat-online {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    margin: 0;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(107, 103, 96);
    background-color: rgba(0, 0, 0, 0);
    color: var(--chat-paper);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
    white-space: nowrap;
}

.chat-online--active,
.chat-online:hover,
.chat-online:focus {
    border-color: var(--chat-acid);
    color: var(--chat-acid);
}

.chat-presence-dot {
    width: 7px;
    height: 7px;
    margin-right: 6px;
    background-color: rgb(74, 222, 128);
}

.chat-presence-dot--offline { background-color: var(--chat-border); }

.chat-main {
    display: flex;
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
    padding: 6px 8px 8px 8px;
}

.chat-history {
    flex-grow: 1;
    min-height: 0;
    padding: 2px 2px 0 2px;
}

.chat-empty {
    padding: 8px 2px;
    color: var(--chat-muted);
    font-size: 12px;
    white-space: normal;
}

.chat-feedback {
    min-height: 0;
    margin-top: 2px;
    color: var(--chat-muted);
    font-size: 12px;
    letter-spacing: 0.4px;
    white-space: normal;
}

.chat-feedback--in-history {
    margin-top: 4px;
    padding: 4px 2px;
    color: var(--chat-orange);
    font-size: 11px;
}

.chat-feedback--success { color: var(--chat-green); }
.chat-feedback--pending { color: var(--chat-muted); }

.chat-newest {
    display: none;
    align-self: flex-end;
    min-height: 24px;
    margin: 4px 0;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 0;
    border-color: var(--chat-border);
    background-color: var(--chat-surface);
    color: var(--chat-acid);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.chat-main > .chat-compose { margin-top: 6px; }

.chat-action {
    min-height: 36px;
    margin: 0;
    border-width: 0;
    border-left-width: 1px;
    border-radius: 0;
    border-color: var(--chat-ink);
    background-color: var(--chat-paper);
    color: var(--chat-ink);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-compose .chat-action { width: 66px; min-height: 0; }

.chat-action--primary:hover,
.chat-action--primary:focus {
    background-color: var(--chat-acid);
}

.chat-action:disabled {
    background-color: var(--chat-surface);
    color: var(--chat-muted);
    opacity: 1;
}

/* Directory: who is online, direct messages and personal mute. */
.chat-directory {
    display: none;
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.chat-directory--visible { display: flex; }

.chat-directory__bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 4px;
}

.online-list {
    flex-grow: 1;
    min-height: 0;
}

.online-row {
    min-height: 28px;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(123, 120, 114, 0.3);
}

.online-player {
    flex-grow: 1;
    flex-basis: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 26px;
    margin: 0;
    padding-left: 4px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--chat-paper);
    font-size: 13px;
    -unity-text-align: middle-left;
    white-space: normal;
}

.online-player:hover,
.online-player:focus { color: var(--chat-acid); }

.chat-section-label {
    margin-top: 8px;
    margin-bottom: 2px;
    color: var(--chat-acid);
    font-size: 10px;
    letter-spacing: 2px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
}

.chat-action--small,
.chat-mute {
    min-height: 24px;
    margin: 0 0 0 6px;
    padding: 0 8px;
    border-width: 1px;
    border-radius: 0;
    border-color: var(--chat-border);
    background-color: var(--chat-surface);
    color: var(--chat-paper);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-action--small:hover,
.chat-action--small:focus,
.chat-mute:hover,
.chat-mute:focus,
.chat-newest:hover,
.chat-newest:focus {
    border-color: var(--chat-acid);
    color: var(--chat-acid);
}

/* Corner controls: minimize and the resize grip. */
.chat-corner-actions {
    position: absolute;
    top: 6px;
    right: 6px;
    flex-direction: row;
    align-items: center;
}

.chat-icon-button {
    width: 26px;
    height: 26px;
    min-height: 26px;
    margin: 0 0 0 4px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-radius: 0;
    border-color: var(--chat-ink);
    background-color: var(--chat-paper);
}

.chat-icon-button:hover,
.chat-icon-button:focus {
    border-color: var(--chat-acid);
    background-color: var(--chat-acid);
}

.chat-icon-minimize { width: 14px; height: 2px; background-color: var(--chat-ink); }

.chat-resize-grip {
    position: relative;
    width: 26px;
    height: 26px;
    margin-left: 4px;
    border-width: 1px;
    border-color: var(--chat-ink);
    background-color: var(--chat-paper);
}

.chat-resize-grip:hover { border-color: var(--chat-acid); background-color: var(--chat-acid); }

.chat-resize-mark {
    position: absolute;
    left: 2px;
    top: 7px;
    width: 13px;
    height: 2px;
    rotate: -45deg;
    background-color: var(--chat-ink);
}

.chat-resize-mark--second { left: 6px; top: 11px; width: 8px; }

/* ── Menu: minimized slim tab ────────────────────────────────────────────── */

.chat-collapsed {
    display: none;
    position: absolute;
    left: 0;
    bottom: 0;
    right: 0;
    flex-direction: row;
    align-items: flex-end;
}

.chat-open {
    flex-direction: row;
    align-items: stretch;
    height: 36px;
    max-width: 100%;
    margin: 0;
    padding: 0 12px 0 0;
    border-width: 2px;
    border-radius: 0;
    border-color: var(--chat-paper);
    background-color: var(--chat-deep-ink);
}

.chat-open:hover,
.chat-open:focus { border-color: var(--chat-acid); }

.chat-open:active { translate: 0 2px; }

.chat-open__title {
    margin: 0;
    padding: 0 12px;
    background-color: var(--chat-paper);
    color: var(--chat-ink);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.chat-open:hover .chat-open__title,
.chat-open:focus .chat-open__title { background-color: var(--chat-acid); }

.chat-unread {
    display: none;
    align-self: center;
    margin: 0 0 0 10px;
    padding: 3px 6px 2px 6px;
    background-color: var(--chat-orange);
    color: var(--chat-ink);
    font-size: 11px;
    -unity-font-style: bold;
    white-space: nowrap;
}

.chat-unread--visible { display: flex; }

.chat-peek {
    display: none;
    flex-shrink: 1;
    min-width: 0;
    max-width: 340px;
    align-self: center;
    margin: 0 0 0 10px;
    padding: 0 0 0 10px;
    border-left-width: 1px;
    border-left-color: var(--chat-rule);
    color: var(--chat-paper);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.chat-peek--visible { display: flex; }

.chat-presence {
    flex-shrink: 0;
    align-self: center;
    margin: 0 0 0 10px;
    color: var(--chat-paper);
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
    white-space: nowrap;
}
