.feedback-card { width: 650px; max-width: 96%; padding: 24px; background-color: rgb(25, 29, 40); color: rgb(238, 241, 248); }
.feedback-card Label { white-space: normal; margin-bottom: 8px; }
.feedback-card Button { min-height: 34px; margin-top: 4px; }
.feedback-card Button:focus { border-width: 3px; border-color: rgb(116, 214, 255); }
.feedback-card .selected { background-color: rgb(45, 91, 113); }
.feedback-card TextField { min-height: 80px; margin-bottom: 8px; }
