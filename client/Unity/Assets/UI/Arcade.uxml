<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="page-frag">
        <ui:VisualElement name="page-header" class="page-section frag-header arcade-header">
            <ui:Button name="btn-back" text="BACK" class="btn-back" />
            <ui:Label text="ARCADE" class="arcade-page-title" />
        </ui:VisualElement>
        <ui:VisualElement name="page-body" class="page-section arcade-body">
            <ui:VisualElement class="arcade-layout">
                <ui:VisualElement class="arcade-mode-browser">
                    <ui:Label text="CHOOSE A MODE" class="arcade-section-label" />
                    <ui:ScrollView name="arcade-modes" class="arcade-mode-gallery arcade-mode-gallery--single" horizontal-scroller-visibility="Hidden">
                        <ui:Button name="arcade-mode-slopball" class="arcade-mode-card arcade-mode-card--selected" tooltip="Slopball">
                            <ui:VisualElement class="arcade-mode-caption" picking-mode="Ignore">
                                <ui:VisualElement class="arcade-mode-heading">
                                    <ui:Label text="SLOPBALL" class="arcade-mode-title" />
                                    <ui:VisualElement class="arcade-mode-check" />
                                </ui:VisualElement>
                                <ui:Label text="Land the ball beyond the net. A miss resets your combo." class="arcade-mode-rule" />
                            </ui:VisualElement>
                            <ui:VisualElement class="arcade-mode-art arcade-mode-art--slopball" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="arcade-mode-course" class="arcade-mode-card" tooltip="FightGuy's timed sanctuary course">
                            <ui:VisualElement class="arcade-mode-caption" picking-mode="Ignore">
                                <ui:VisualElement class="arcade-mode-heading">
                                    <ui:Label text="SANCTUARY COURSE" class="arcade-mode-title" />
                                    <ui:VisualElement class="arcade-mode-check" />
                                </ui:VisualElement>
                                <ui:Label text="Break every target. Reach the shrine. Beat your time." class="arcade-mode-rule" />
                            </ui:VisualElement>
                            <ui:VisualElement class="arcade-mode-art arcade-mode-art--course" picking-mode="Ignore">
                                <ui:Label text="ROOFS. POLES.&#10;FLOATING ISLANDS." class="course-card-route" />
                                <ui:Label text="FIGHTGUY" class="arcade-section-label" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="arcade-setup" class="arcade-setup">
                    <ui:Label name="arcade-selected-mode" text="SLOPBALL" class="arcade-selected-mode" />
                    <ui:Label text="CHOOSE YOUR FIGHTER" class="arcade-section-label" />
                    <ui:VisualElement name="arcade-roster" class="arcade-roster">
                        <ui:VisualElement name="arcade-fighters" class="arcade-fighters" />
                    </ui:VisualElement>
                    <ui:VisualElement class="arcade-record-panel">
                        <ui:Label name="arcade-best-fighter" class="arcade-best-fighter" />
                        <ui:Label name="arcade-best" class="arcade-best" />
                        <ui:Foldout name="arcade-older-bests" text="PAST VERSIONS" value="false">
                            <ui:ScrollView name="arcade-archive" class="arcade-archive" />
                        </ui:Foldout>
                        <ui:Label name="arcade-feedback" class="arcade-feedback" />
                    </ui:VisualElement>
                    <ui:Toggle name="arcade-course-tips" text="MOVEMENT TIPS" value="false" />
                    <ui:VisualElement class="arcade-launch-row">
                        <ui:Button name="arcade-play" text="PLAY SLOPBALL" class="btn-primary" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
