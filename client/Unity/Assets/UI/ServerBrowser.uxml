<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Server Browser page fragment (issue #221). Mounted into the
         FrontendShell hosts: header → PageHeaderHost, room list plus the
         compact hosting/address tools → PageBodyHost, connection/operation
         feedback → PageSummaryHost, host/join actions → PageActionsHost.
         The direct-connect form mounts into the shell modal host as the
         page-modal section and opens through ServerBrowserUI. -->
    <ui:VisualElement name="page-frag">
        <ui:VisualElement name="page-header" class="page-section browser-header-section">
            <ui:Button name="btn-back" text="BACK" class="btn-back" />
            <ui:VisualElement class="flow-header-copy">
                <ui:Label name="title" text="SERVER BROWSER" class="flow-title" />
                <ui:Label text="Find a room, or make one for the crew." class="flow-subtitle" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="page-body" class="page-section browser-body-section">
            <ui:VisualElement name="browser-layout" class="browser-layout">
                <ui:VisualElement name="browser-panel" class="browser-panel">
                    <ui:VisualElement class="browser-panel__header">
                        <ui:Label text="ROOMS TO JOIN" class="panel-title" />
                        <ui:Label text="PUBLIC LIST" class="panel-note" />
                    </ui:VisualElement>
                    <ui:ScrollView name="server-list" class="server-list" mode="Vertical" horizontal-scroller-visibility="Hidden" />
                    <!-- Scan feedback (loading, empty, unreachable) lives with the list it
                         describes, clear of the bottom-left chat overlay. -->
                    <ui:VisualElement class="browser-panel__footer">
                        <ui:Label name="lbl-status" text="Loading the room list…" class="browser-status" />
                        <ui:Button name="btn-refresh" text="REFRESH" class="btn-secondary browser-refresh" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:ScrollView name="browser-tools" class="browser-tools" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:VisualElement name="create-room-panel" class="browser-tool browser-host-panel">
                        <ui:Label text="CREATE A ROOM" class="panel-title" />
                        <ui:Label text="Create a public room without starting a game server." class="tool-copy" />
                        <ui:Label text="ROOM NAME" class="field-label" />
                        <ui:TextField name="room-name-field" placeholdertext="Room name" class="browser-input" />
                        <ui:Button name="btn-create-room" text="CREATE ROOM" class="btn-hot" />
                    </ui:VisualElement>
                    <ui:VisualElement name="legacy-host-panel" class="browser-tool browser-host-panel">
                        <ui:Label text="DEV ONLY // LEGACY HOST &amp; PLAY" class="panel-title" />
                        <ui:Label text="Editor-only development route. Starts a local game server through the physical lobby API." class="tool-copy" />
                        <ui:Label text="PUBLIC ADDRESS (OPTIONAL)" class="field-label" />
                        <ui:TextField name="host-ip-field" placeholdertext="auto-detect" class="browser-input" />
                        <ui:Label text="Leave blank to advertise the server's detected address." class="field-help" />
                    </ui:VisualElement>
                    <ui:VisualElement name="direct-connect-panel" class="browser-tool browser-direct-panel">
                        <ui:Label text="DEV ONLY // JOIN BY ADDRESS" class="panel-title" />
                        <ui:Label text="Editor-only development route for a registered physical server address." class="tool-copy" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="page-summary" class="page-section browser-summary-section">
            <ui:Label name="lbl-host-status" class="host-status" style="display: none;" />
        </ui:VisualElement>
        <ui:VisualElement name="page-actions" class="page-section browser-actions-section">
            <ui:Button name="btn-host-cancel" text="CANCEL HOST" class="btn-secondary host-cancel" style="display: none;" />
            <ui:Button name="btn-host" text="DEV HOST &amp; PLAY" class="btn-hot" />
            <ui:Button name="btn-direct-connect" text="DEV JOIN BY ADDRESS" class="btn-secondary" />
        </ui:VisualElement>
    </ui:VisualElement>
    <!-- The page modal mounts into the shell modal host (issue #221);
         ServerBrowserUI presents it over the page while the lookup runs. -->
    <ui:VisualElement name="page-modal" class="page-modal-layer" picking-mode="Ignore">
        <ui:VisualElement name="direct-connect-modal" class="direct-connect-modal" style="display: none;">
            <ui:VisualElement class="direct-connect-card">
                <ui:Label text="JOIN BY ADDRESS" class="direct-connect-title" />
                <ui:Label text="Find a registered server by its IPv4 address." class="direct-connect-copy" />
                <ui:Label text="SERVER ADDRESS" class="field-label" />
                <ui:TextField name="ip-field" value="127.0.0.1" placeholdertext="192.168.1.20:9876" class="direct-connect-input" />
                <ui:Label name="direct-connect-status" class="direct-connect-status" />
                <ui:VisualElement class="direct-connect-actions">
                    <ui:Button name="btn-modal-close" text="CANCEL" class="btn-secondary" />
                    <ui:Button name="btn-modal-join" text="JOIN FIGHT" class="btn-hot" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
