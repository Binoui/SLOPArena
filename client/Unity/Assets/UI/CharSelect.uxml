<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Fighter Select page fragment (issue #219). The shell mounts its
         header, body, summary and actions separately. Training and Solo share
         player/CPU selection; PvP uses its own status and actions.
         Selection state lives in CharSelectController. -->
    <ui:VisualElement name="page-frag">
        <ui:VisualElement name="page-header" class="page-section frag-header">
        <ui:Button name="btn-back" text="BACK" class="btn-back" />
        <ui:VisualElement class="flow-header-copy">
            <ui:Label text="MATCH SETUP" class="flow-eyebrow" />
            <ui:Label name="title" text="CHARACTER SELECT" class="flow-title" />
            <ui:Label text="Pick the face you want attached to the problem." class="flow-subtitle" />
        </ui:VisualElement>
        <ui:VisualElement name="char-header-status" class="char-header-status">
            <ui:Label name="flow-progress" text="STEP 1 OF 2" class="flow-progress" />
            <ui:Label name="roster-meta" text="4 FIGHTERS" class="char-select-meta" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="page-body" class="page-section char-body-section">
        <ui:VisualElement name="char-grid" class="char-grid" />
    </ui:VisualElement>
    <ui:VisualElement name="page-summary" class="page-section char-summary-section">
        <ui:VisualElement name="roster-panel" class="roster-panel" />
        <ui:VisualElement name="local-record-panel" class="local-record-panel" style="display: none;">
            <ui:VisualElement name="local-record-poster" class="local-record-poster" />
            <ui:Label name="arcade-selected-mode" class="local-record-title" />
            <ui:Label name="arcade-best-fighter" class="local-record-label" />
            <ui:Label name="arcade-best" class="local-record-best" />
            <ui:Foldout name="arcade-older-bests" text="PAST VERSIONS" value="false">
                <ui:ScrollView name="arcade-archive" class="local-record-archive" />
            </ui:Foldout>
            <ui:Label name="arcade-feedback" class="local-record-feedback" />
            <ui:Toggle name="arcade-course-tips" text="MOVEMENT TIPS" />
        </ui:VisualElement>
        <ui:VisualElement name="colour-select" class="solo-config" style="display: none;">
            <ui:Label text="YOUR COLOUR" class="selection-target" />
            <ui:VisualElement class="selection-target-buttons">
                <ui:Button name="btn-colour-0" text="TEAL" class="selection-target-button" />
                <ui:Button name="btn-colour-1" text="CLAY" class="selection-target-button" />
                <ui:Button name="btn-colour-2" text="GOLD" class="selection-target-button" />
                <ui:Button name="btn-colour-3" text="LILAC" class="selection-target-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="camp-select" class="solo-config" style="display: none;">
            <ui:Label name="camp-label" text="YOUR CAMP" class="selection-target" />
            <ui:VisualElement class="selection-target-buttons">
                <ui:Button name="btn-camp-teal" text="TEAL" class="selection-target-button" />
                <ui:Button name="btn-camp-clay" text="CLAY" class="selection-target-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="page-actions" class="page-section char-actions-section">
        <ui:VisualElement name="pvp-action-area" class="pvp-action-area">
            <ui:Label name="lbl-pvp-status" text="Choose a fighter, then lock in." class="pvp-status" />
            <ui:VisualElement name="pvp-buttons" class="pvp-buttons">
                <ui:Button name="btn-lockin" text="LOCK IN" class="btn-secondary pvp-btn" />
                <ui:Button name="btn-start-match" text="SELECT STAGE" class="btn-primary pvp-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="solo-next-action" class="solo-next-action">
            <ui:Button name="btn-select" text="SELECT STAGE" class="btn-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
