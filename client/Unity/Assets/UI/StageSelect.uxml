<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Stage Select page fragment (issue #221). Mounted into the
         FrontendShell hosts: header → PageHeaderHost, the stage grid in an
         intentional scroll region → PageBodyHost, participant summary →
         PageSummaryHost, selected-stage label and the primary start action →
         PageActionsHost. Real selection state lives in StageSelectController. -->
    <ui:VisualElement name="page-frag">
        <ui:VisualElement name="page-header" class="page-section stage-header-section">
            <ui:Button name="btn-back" text="BACK" class="btn-back" />
            <ui:VisualElement class="flow-header-copy">
                <ui:Label name="title" text="SELECT STAGE" class="flow-title" />
                <ui:Label name="subtitle" text="Choose the place where this goes wrong." class="flow-subtitle" />
            </ui:VisualElement>
            <ui:VisualElement class="stage-header-status">
                <ui:Label name="flow-progress" text="STEP 2 OF 2" class="flow-progress" />
                <ui:Label name="lbl-host" text="CHOOSE YOUR STAGE" class="stage-host-status" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="page-body" class="page-section stage-body-section">
            <!-- Online Rooms choose what to play first (ADR-0040): PVP stages or Arcade modes.
                 Solo and Training keep the plain stage grid; the tabs stay hidden there. -->
            <ui:VisualElement name="stage-tabs" class="stage-tabs" style="display: none;">
                <ui:Button name="stage-tab-pvp" text="PVP" class="shell-nav-tab stage-tab" />
                <ui:Button name="stage-tab-arcade" text="ARCADE" class="shell-nav-tab stage-tab" />
            </ui:VisualElement>
            <ui:ScrollView name="stage-scroll" class="stage-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement name="stage-grid" class="stage-grid" />
                <ui:VisualElement name="stage-arcade" class="stage-arcade" style="display: none;">
                    <ui:Button name="stage-arcade-slopball" class="arcade-mode-card stage-arcade-card" tooltip="Slopball online is coming">
                        <ui:VisualElement class="arcade-mode-caption" picking-mode="Ignore">
                            <ui:VisualElement class="arcade-mode-heading">
                                <ui:Label text="SLOPBALL" class="arcade-mode-title" />
                                <ui:Label text="COMING ONLINE" class="stage-arcade-soon" />
                            </ui:VisualElement>
                            <ui:Label text="Volleyball across the net, or co-op against the Launcher." class="arcade-mode-rule" />
                        </ui:VisualElement>
                        <ui:VisualElement class="arcade-mode-art arcade-mode-art--slopball" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="stage-arcade-course" class="arcade-mode-card stage-arcade-card" tooltip="Character Courses online are coming">
                        <ui:VisualElement class="arcade-mode-caption" picking-mode="Ignore">
                            <ui:VisualElement class="arcade-mode-heading">
                                <ui:Label text="CHARACTER COURSES" class="arcade-mode-title" />
                                <ui:Label text="COMING ONLINE" class="stage-arcade-soon" />
                            </ui:VisualElement>
                            <ui:Label text="Race or team up on a fighter's own course." class="arcade-mode-rule" />
                        </ui:VisualElement>
                        <ui:VisualElement class="arcade-mode-art arcade-mode-art--course" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
        <ui:VisualElement name="page-summary" class="page-section stage-summary-section">
            <ui:VisualElement name="player-cards-area" class="stage-player-cards" />
        </ui:VisualElement>
        <ui:VisualElement name="page-actions" class="page-section stage-actions-section">
            <ui:Label name="lbl-selected-stage" text="NO STAGE SELECTED" class="stage-selected-label" />
            <ui:Label name="lbl-waiting" text="WAITING FOR HOST" class="stage-waiting" style="display: none;" />
            <ui:Button name="btn-confirm" text="START MATCH" class="btn-primary stage-confirm" style="display: none;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
