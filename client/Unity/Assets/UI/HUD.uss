/* Gameplay HUD: stable match readouts, player identity, and ability feedback. */

.hud-root {
    flex-grow: 1;
    pointer-events: none;
}

/* Solo's start is printed like a fight poster, above the fighters. */
.solo-countdown {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}

.solo-countdown-anchor {
    position: absolute;
    left: 50%;
    top: 32%;
    translate: -50% -50%;
    width: 480px;
    height: 190px;
    align-items: center;
    justify-content: center;
}

.solo-countdown-stamp {
    width: 268px;
    height: 84px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #1B1A18;
    transform-origin: center;
}

.solo-countdown-title,
.solo-countdown-print {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-center;
    font-size: 48px;
    white-space: nowrap;
}

.solo-countdown-title {
    color: #1B1A18;
}

.solo-countdown-print {
    color: #E05C2A;
    translate: 3px 3px;
}

.solo-countdown--number .solo-countdown-stamp {
    width: 148px;
    height: 156px;
}

.solo-countdown--number .solo-countdown-title,
.solo-countdown--number .solo-countdown-print {
    font-size: 122px;
}

.solo-countdown--start .solo-countdown-stamp {
    width: 468px;
    height: 106px;
    background-color: #FFCC22;
    border-width: 3px;
}

.solo-countdown--start .solo-countdown-title,
.solo-countdown--start .solo-countdown-print {
    font-size: 48px;
}


/* Multiplayer-safe left stack: one stable row per roster member. */
.solo-end {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}

.solo-end-anchor {
    position: absolute;
    left: 50%;
    top: 32%;
    translate: -50% -50%;
    width: 640px;
    height: 240px;
    align-items: center;
    justify-content: center;
}

.solo-end-poster {
    width: 640px;
    height: 226px;
    flex-direction: row;
    align-items: center;
    rotate: -3deg;
    transform-origin: center;
}

.solo-end-portrait-slip {
    width: 166px;
    height: 198px;
    margin-right: 14px;
    padding: 8px 8px 5px 8px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #1B1A18;
    rotate: 4deg;
}

.solo-end-portraits {
    height: 150px;
    flex-direction: row;
    justify-content: center;
}

.solo-end-portrait {
    width: 144px;
    height: 150px;
}

.solo-end-other-portrait {
    display: none;
    width: 72px;
    height: 150px;
}

.solo-end-name {
    margin: 4px 0 0 0;
    padding: 0;
    font-size: 22px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-center;
    color: #1B1A18;
    white-space: nowrap;
}

.solo-end-declaration {
    width: 460px;
    height: 226px;
    padding: 8px 14px 12px 14px;
    background-color: #FFCC22;
    border-width: 3px;
    border-color: #1B1A18;
}

.solo-end-headline {
    height: 156px;
    flex-shrink: 0;
    position: relative;
}

.solo-end-title,
.solo-end-print {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 68px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
    white-space: normal;
}

.solo-end-title { color: #1B1A18; }
.solo-end-print { color: #E05C2A; translate: 3px 3px; }

.solo-end-outcome {
    height: 38px;
    flex-shrink: 0;
    margin: 3px 0 0 0;
    padding: 0 8px;
    background-color: #1B1A18;
    color: #F0EEE8;
    font-size: 26px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.solo-end--shared .solo-end-declaration { background-color: #F0EEE8; }
.solo-end--shared .solo-end-portraits { height: 140px; }
.solo-end--shared .solo-end-portrait { width: 72px; height: 140px; }
.solo-end--shared .solo-end-other-portrait { display: flex; height: 140px; }
.solo-end--shared .solo-end-name { font-size: 14px; height: 34px; white-space: normal; }

.player-billboard {
    position: absolute;
    left: 18px;
    right: auto;
    top: 18px;
    bottom: auto;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.billboard-card {
    position: relative;
    width: 330px;
    height: 120px;
    margin: 0;
    margin-bottom: 16px;
    overflow: visible;
    flex-direction: row;
    align-items: stretch;
    background-color: #1B1A18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.stock-toast-player {
    position: absolute;
    left: 342px;
    top: 24px;
    width: 172px;
    height: 78px;
    padding: 3px 10px 6px 10px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 5px;
    rotate: -5deg;
    transform-origin: left center;
}

.stock-toast-title {
    height: 46px;
    margin: 0;
    padding: 0;
    color: #1B1A18;
    font-size: 42px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
}

.stock-toast-detail {
    margin: 0;
    padding: 0;
    color: #1B1A18;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.stock-toast-player--out {
    background-color: #161513;
    border-color: #F0EEE8;
}

.stock-toast-player--out .stock-toast-title {
    color: #EF4444;
}

.stock-toast-player--out .stock-toast-detail {
    color: #F0EEE8;
}

.billboard-left {
    padding-left: 108px;
}


.billboard-card.eliminated .fighter-portrait {
    opacity: 0.5;
}


.portrait-frame {
    position: absolute;
    left: -3px;
    top: -5px;
    width: 100px;
    height: 120px;
    overflow: hidden;
    border-width: 2px;
    border-color: #F0EEE8;
    background-color: #e05c2a;
    rotate: -2deg;
}



.portrait-missing {
    opacity: 0.2;
}

.fighter-portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.fighter-copy {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    padding: 6px 10px 2px 6px;
}

.fighter-details {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}


.fighter-tape {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: #F0EEE8;
    rotate: -2deg;
}


.billboard-card .badge {
    min-width: 34px;
    height: 22px;
    padding: 1px 5px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #161513;
}


.fighter-name {
    margin-left: 8px;
    height: 22px;
    font-size: 14px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #F0EEE8;
    -unity-text-align: middle-left;
}




.billboard-card .overhead-damage {
    flex-shrink: 0;
    height: 56px;
    margin: 0;
    padding: 0;
    font-size: 54px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
    transition-property: color, translate;
    transition-duration: 0.12s;
}

.billboard-card .overhead-damage.damage-hit {
    translate: 0 -3px;
}

.stock-row {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: #7B7872;
}

.stock-label {
    min-width: 45px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: #F0EEE8;
}

.stock-tickets {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.stock-icon {
    width: 16px;
    height: 12px;
    flex-shrink: 0;
    margin-left: 6px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #F0EEE8;
}

.stock-icon.lost {
    background-color: #1B1A18;
    border-color: #7B7872;
}

.stock-strike {
    position: absolute;
    display: none;
    left: 0;
    top: 3px;
    width: 12px;
    height: 2px;
    rotate: -35deg;
    background-color: #7B7872;
}

.stock-icon.lost .stock-strike {
    display: flex;
}

.many-stocks .stock-icon {
    width: 11px;
    height: 10px;
    margin-left: 3px;
}

.many-stocks .stock-strike {
    width: 7px;
    top: 2px;
}

.stock-count {
    min-width: 28px;
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: #F0EEE8;
    -unity-font-style: bold;
}

/* Move keys: a paper tab per normal over a raised ink key per special.
   Depth is state. A ready key stands on its offset plate; it sinks while its
   move runs or cools down, refills, then pops back up with a brief yellow edge. */
.move-deck {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    height: 132px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.move-pairs {
    position: relative;
    flex-direction: row;
    flex-shrink: 0;
    transform-origin: right bottom;
}

.move-pair {
    position: relative;
    width: 68px;
    margin: 0 4px;
    flex-shrink: 0;
    flex-direction: column;
    overflow: visible;
}

.slot {
    position: relative;
    flex-shrink: 0;
    overflow: visible;
}

.normal-slot {
    width: 67px;
    height: 37px;
}

.special-slot {
    width: 68px;
    height: 68px;
    margin-top: 8px;
}

.slot-plate {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 64px;
    height: 34px;
    background-color: #161513;
}

.special-slot .slot-plate {
    left: 4px;
    top: 4px;
    height: 64px;
    background-color: #39A9FF;
    border-width: 2px;
    border-color: #161513;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.slot.locked .slot-plate {
    display: none;
}

.slot-face {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 34px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
    transition-property: translate, border-color;
    transition-duration: 0.07s;
}

.special-slot .slot-face {
    height: 64px;
    background-color: #1B1A18;
    border-color: #F0EEE8;
}

.normal-slot.in-use .slot-face,
.normal-slot.on-cooldown .slot-face {
    translate: 3px 3px;
}

.special-slot.in-use .slot-face,
.special-slot.on-cooldown .slot-face {
    translate: 4px 4px;
}

.special-slot.on-cooldown .slot-face {
    border-color: #6F6A73;
}

.special-slot.ready-pulse .slot-face {
    translate: -1px -1px;
    border-color: #FFCC22;
}

.slot.quiet-feedback .slot-face {
    transition-duration: 0s;
}

.special-slot.quiet-feedback.ready-pulse .slot-face {
    translate: 0 0;
}

.slot-name {
    display: none;
}

.slot-content {
    position: absolute;
    left: 26px;
    top: 0;
    width: 30px;
    height: 30px;
}

.special-slot .slot-content {
    left: 2px;
    top: 2px;
    width: 56px;
    height: 56px;
}

.slot-icon-inner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.slot.on-cooldown .slot-icon-inner {
    opacity: 0.3;
}

.slot.locked .slot-icon-inner {
    opacity: 0.35;
}

/* Refill: grows from the bottom as the cooldown elapses (height set by HUDManager). */
.slot-cooldown {
    position: absolute;
    display: none;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(57, 169, 255, 0.2);
    border-top-width: 2px;
    border-color: #39A9FF;
}

.slot-timer {
    position: absolute;
    display: none;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    color: #F0EEE8;
}

.normal-slot .slot-timer {
    font-size: 14px;
}

/* Cooldown completion is shown by the pop and yellow edge, not a text tag. */
.slot-ready {
    display: none;
}

.slot-prompt {
    position: absolute;
    left: 1px;
    top: 0;
    min-width: 22px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slot-prompt-image {
    display: none;
    width: 22px;
    height: 22px;
}

.slot-key-label {
    margin: 0;
    padding: 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: #1B1A18;
}

.special-slot .slot-prompt {
    left: -9px;
    top: -9px;
    min-width: 0;
    height: auto;
    rotate: -4deg;
}

.special-slot .slot-key-label {
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    font-size: 12px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
}

.controller-prompts .special-slot .slot-prompt {
    display: none;
}

.move-tooltip {
    position: absolute;
    display: none;
    top: -34px;
    width: 240px;
    height: 26px;
    margin: 0;
    padding: 0 8px;
    background-color: #F0EEE8;
    color: #1B1A18;
    border-width: 1px;
    border-color: #1B1A18;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.modifier-rail {
    display: none;
}

/* Controller only: specials share each face button behind the modifier. */
.modifier-prompt {
    position: absolute;
    left: -58px;
    top: 63px;
    height: 28px;
    min-width: 48px;
    padding: 0 6px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #1B1A18;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.keyboard-modifier {
    display: none;
}

.modifier-button {
    width: 34px;
    height: 24px;
    background-color: #1B1A18;
}

.modifier-key {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: #1B1A18;
}

.modifier-plus {
    margin: 0;
    padding: 0 0 0 3px;
    color: #1B1A18;
    font-size: 16px;
    -unity-font-style: bold;
}

.modifier-held .modifier-prompt,
.modifier-held .special-slot .slot-plate {
    background-color: #FFCC22;
}

/* Locked marker keeps its anchor when the optional damage tab is hidden. */
.target-lock {
    position: absolute;
    display: none;
    width: 100px;
    height: 58px;
}

.target-lock.visible {
    display: flex;
}

.target-lock-readout {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #1B1A18;
}

.target-lock.damage-hidden .target-lock-readout {
    display: none;
}

.target-lock-damage {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #F0EEE8;
}

.target-lock-percent {
    margin: 0;
    margin-left: 2px;
    padding: 0;
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    translate: 0 3px;
    color: #F0EEE8;
}

.target-lock-marker {
    position: absolute;
    left: 29px;
    bottom: 0;
    width: 42px;
    height: 26px;
}

.target-lock-bracket {
    position: absolute;
    top: 0;
    width: 10px;
    height: 15px;
    border-top-width: 3px;
    border-top-color: #EF4444;
}

.target-lock-bracket-left {
    left: 0;
    border-left-width: 3px;
    border-left-color: #EF4444;
}

.target-lock-bracket-right {
    right: 0;
    border-right-width: 3px;
    border-right-color: #EF4444;
}

.target-lock-pointer {
    position: absolute;
    top: 12px;
    width: 15px;
    height: 4px;
    background-color: #EF4444;
}

.target-lock-pointer-left {
    left: 8px;
    rotate: 45deg;
}

.target-lock-pointer-right {
    right: 8px;
    rotate: -45deg;
}

/* Match overlays share the frontend control language, not gameplay colors. */
.match-pause-cover {
    background-color: rgba(22, 21, 19, 0.72);
}

.match-pause-box {
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.match-pause-title {
    color: #1b1a18;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action {
    background-color: #f0eee8;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 5px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action--primary { background-color: #ffcc22; }

.match-pause-action:hover,
.match-pause-action:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.match-pause-action:active { translate: 0 3px; }

.match-pause-action:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

.shell-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.8);
}

.shell-modal-box {
    min-width: 320px;
    max-width: 560px;
    padding: 20px 24px;
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.shell-modal-title {
    color: #1b1a18;
    font-size: 24px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    white-space: normal;
}

.shell-modal-help {
    margin-top: 8px;
    margin-bottom: 14px;
    color: #252422;
    font-size: 15px;
    white-space: normal;
}

.shell-modal-row {
    flex-direction: row;
    align-items: stretch;
}

.shell-modal-submit {
    flex-grow: 1;
    min-height: 40px;
    margin-right: 6px;
    padding: 0 16px;
    background-color: #ffcc22;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.shell-modal-submit--secondary { background-color: #f0eee8; }

.shell-modal-submit:hover,
.shell-modal-submit:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.shell-modal-submit:active { translate: 0 3px; }

.shell-modal-submit:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

#steam-room-join-notice {
    background-color: rgba(22, 21, 19, 0.96);
    color: #f0eee8;
    border-width: 1px;
    border-color: #7b7872;
}
