/* Gameplay HUD: stable match readouts, player identity, and ability feedback. */

.hud-root {
    flex-grow: 1;
    pointer-events: none;
}


/* Multiplayer-safe left stack: one stable row per roster member. */
.player-billboard {
    position: absolute;
    left: 18px;
    right: auto;
    top: 18px;
    bottom: auto;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.billboard-card {
    position: relative;
    width: 330px;
    height: 120px;
    margin: 0;
    margin-bottom: 16px;
    overflow: visible;
    flex-direction: row;
    align-items: stretch;
    background-color: #1B1A18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.stock-toast-player {
    position: absolute;
    left: 342px;
    top: 24px;
    width: 172px;
    height: 78px;
    padding: 3px 10px 6px 10px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 5px;
    rotate: -5deg;
    transform-origin: left center;
}

.stock-toast-title {
    height: 46px;
    margin: 0;
    padding: 0;
    color: #1B1A18;
    font-size: 42px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
}

.stock-toast-detail {
    margin: 0;
    padding: 0;
    color: #1B1A18;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.stock-toast-player--out {
    background-color: #161513;
    border-color: #F0EEE8;
}

.stock-toast-player--out .stock-toast-title {
    color: #EF4444;
}

.stock-toast-player--out .stock-toast-detail {
    color: #F0EEE8;
}

.billboard-left {
    padding-left: 108px;
}


.billboard-card.eliminated .fighter-portrait {
    opacity: 0.5;
}


.portrait-frame {
    position: absolute;
    left: -3px;
    top: -5px;
    width: 100px;
    height: 120px;
    overflow: hidden;
    border-width: 2px;
    border-color: #F0EEE8;
    background-color: #e05c2a;
    rotate: -2deg;
}



.portrait-missing {
    opacity: 0.2;
}

.fighter-portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.fighter-copy {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    padding: 6px 10px 2px 6px;
}

.fighter-details {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}


.fighter-tape {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: #F0EEE8;
    rotate: -2deg;
}


.billboard-card .badge {
    min-width: 34px;
    height: 22px;
    padding: 1px 5px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #161513;
}


.fighter-name {
    margin-left: 8px;
    height: 22px;
    font-size: 14px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #F0EEE8;
    -unity-text-align: middle-left;
}




.billboard-card .overhead-damage {
    flex-shrink: 0;
    height: 56px;
    margin: 0;
    padding: 0;
    font-size: 54px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
    transition-property: color, translate;
    transition-duration: 0.12s;
}

.billboard-card .overhead-damage.damage-hit {
    translate: 0 -3px;
}

.stock-row {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: #7B7872;
}

.stock-label {
    min-width: 45px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: #F0EEE8;
}

.stock-tickets {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.stock-icon {
    width: 16px;
    height: 12px;
    flex-shrink: 0;
    margin-left: 6px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #F0EEE8;
}

.stock-icon.lost {
    background-color: #1B1A18;
    border-color: #7B7872;
}

.stock-strike {
    position: absolute;
    display: none;
    left: 0;
    top: 3px;
    width: 12px;
    height: 2px;
    rotate: -35deg;
    background-color: #7B7872;
}

.stock-icon.lost .stock-strike {
    display: flex;
}

.many-stocks .stock-icon {
    width: 11px;
    height: 10px;
    margin-left: 3px;
}

.many-stocks .stock-strike {
    width: 7px;
    top: 2px;
}

.stock-count {
    min-width: 28px;
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: #F0EEE8;
    -unity-font-style: bold;
}

/* Four paired move tickets. The backing geometry is drawn by HUDManager. */
.move-deck {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    height: 132px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.move-pairs {
    position: relative;
    height: 104px;
    flex-direction: row;
    flex-shrink: 0;
    transform-origin: right bottom;
}

.move-pair {
    position: relative;
    width: 136px;
    height: 104px;
    margin: 0 4px;
    flex-shrink: 0;
    overflow: visible;
}

.slot {
    position: relative;
    height: 52px;
    width: 136px;
    flex-shrink: 0;
    overflow: visible;
}

.slot-name {
    display: none;
    height: 40px;
    flex-shrink: 0;
    margin: 0 17px;
    padding: 0;
    white-space: normal;
    font-size: 18px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-center;
    color: #1B1A18;
}

.slot-name.long-move-name {
    font-size: 16px;
}

.normal-slot .slot-name {
    margin-top: 8px;
}

.special-slot .slot-name {
    display: none;
    height: 40px;
    margin-bottom: 5px;
    font-size: 18px;
    color: #F0EEE8;
}

.special-slot .slot-name.long-move-name {
    font-size: 16px;
}

.slot-content {
    position: relative;
    flex-grow: 1;
    margin: 12px 10px 6px 10px;
    overflow: hidden;
}

.special-slot .slot-content {
    margin-top: 6px;
    margin-bottom: 6px;
}

.slot-icon-inner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: scale, translate, opacity;
    transition-duration: 0.12s;
}

.slot.ready-pulse .slot-icon-inner {
    scale: 1.03;
}

.slot.used-pulse .slot-icon-inner {
    scale: 0.95;
    translate: 0 2px;
}

.slot.quiet-feedback .slot-icon-inner {
    scale: 1;
    translate: 0 0;
}

.slot.locked .slot-icon-inner {
    opacity: 0.4;
}

.slot.locked .slot-name {
    font-size: 17px;
}

.slot.on-cooldown .slot-icon-inner {
    opacity: 0.45;
}

.slot-ready {
    position: absolute;
    display: none;
    right: 7px;
    top: 4px;
    width: 50px;
    height: 18px;
    margin: 0;
    padding: 0;
    color: #161513;
    background-color: #E05C2A;
    border-width: 1px;
    border-color: #161513;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.special-slot .slot-ready {
    background-color: #39A9FF;
    left: 7px;
    right: auto;
    top: 4px;
}

.slot.ready-pulse .slot-ready {
    display: flex;
}

.slot-cooldown {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 3px;
    height: 4px;
    display: none;
    transform-origin: left center;
    background-color: #E05C2A;
}

.special-slot .slot-cooldown {
    background-color: #39A9FF;
}

.slot-timer {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 8px;
    margin: 0;
    padding: 0;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
    background-color: #1B1A18;
}

.slot-prompt {
    position: absolute;
    left: 0;
    right: 0;
    top: -18px;
    height: 32px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slot-prompt-image {
    display: none;
    width: 32px;
    height: 32px;
    padding: 2px;
    background-color: #161513;
    border-radius: 16px;
}

.slot-key-label {
    min-width: 28px;
    max-width: 112px;
    height: 28px;
    padding: 0 5px;
    font-size: 18px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #1B1A18;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
}

.special-slot .slot-prompt {
    left: auto;
    right: 6px;
    top: 8px;
    height: 24px;
}

.special-slot .slot-key-label {
    min-width: 22px;
    height: 22px;
    font-size: 12px;
    border-width: 1px;
}

.controller-prompts .special-slot .slot-prompt {
    display: none;
}

.move-tooltip {
    position: absolute;
    display: none;
    top: -48px;
    width: 240px;
    height: 26px;
    margin: 0;
    padding: 0 8px;
    background-color: #F0EEE8;
    color: #1B1A18;
    border-width: 1px;
    border-color: #1B1A18;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.modifier-rail {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 50px;
    height: 5px;
    background-color: #39A9FF;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.modifier-prompt {
    position: absolute;
    left: -42px;
    top: 39px;
    height: 28px;
    min-width: 56px;
    padding: 0 5px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #1B1A18;
}

.modifier-button {
    width: 34px;
    height: 24px;
    background-color: #1B1A18;
}

.modifier-key {
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: #1B1A18;
}

.controller-prompts .modifier-key {
    font-size: 18px;
}

.modifier-plus {
    margin: 0;
    padding: 0 3px;
    color: #1B1A18;
    font-size: 18px;
    -unity-font-style: bold;
}

.keyboard-modifier .modifier-plus {
    display: none;
}

.modifier-held .modifier-prompt,
.modifier-held .modifier-rail {
    background-color: #FFCC22;
}

.modifier-held .special-slot .slot-name {
    color: #FFCC22;
}

/* Locked marker keeps its anchor when the optional damage tab is hidden. */
.target-lock {
    position: absolute;
    display: none;
    width: 100px;
    height: 58px;
}

.target-lock.visible {
    display: flex;
}

.target-lock-readout {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #1B1A18;
}

.target-lock.damage-hidden .target-lock-readout {
    display: none;
}

.target-lock-damage {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #F0EEE8;
}

.target-lock-percent {
    margin: 0;
    margin-left: 2px;
    padding: 0;
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    translate: 0 3px;
    color: #F0EEE8;
}

.target-lock-marker {
    position: absolute;
    left: 29px;
    bottom: 0;
    width: 42px;
    height: 26px;
}

.target-lock-bracket {
    position: absolute;
    top: 0;
    width: 10px;
    height: 15px;
    border-top-width: 3px;
    border-top-color: #EF4444;
}

.target-lock-bracket-left {
    left: 0;
    border-left-width: 3px;
    border-left-color: #EF4444;
}

.target-lock-bracket-right {
    right: 0;
    border-right-width: 3px;
    border-right-color: #EF4444;
}

.target-lock-pointer {
    position: absolute;
    top: 12px;
    width: 15px;
    height: 4px;
    background-color: #EF4444;
}

.target-lock-pointer-left {
    left: 8px;
    rotate: 45deg;
}

.target-lock-pointer-right {
    right: 8px;
    rotate: -45deg;
}

/* Match overlays share the frontend control language, not gameplay colors. */
.match-pause-cover {
    background-color: rgba(22, 21, 19, 0.72);
}

.match-pause-box {
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.match-pause-title {
    color: #1b1a18;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action {
    background-color: #f0eee8;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 5px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action--primary { background-color: #ffcc22; }

.match-pause-action:hover,
.match-pause-action:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.match-pause-action:active { translate: 0 3px; }

.match-pause-action:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

.shell-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.8);
}

.shell-modal-box {
    min-width: 320px;
    max-width: 560px;
    padding: 20px 24px;
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.shell-modal-title {
    color: #1b1a18;
    font-size: 24px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    white-space: normal;
}

.shell-modal-help {
    margin-top: 8px;
    margin-bottom: 14px;
    color: #252422;
    font-size: 15px;
    white-space: normal;
}

.shell-modal-row {
    flex-direction: row;
    align-items: stretch;
}

.shell-modal-submit {
    flex-grow: 1;
    min-height: 40px;
    margin-right: 6px;
    padding: 0 16px;
    background-color: #ffcc22;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.shell-modal-submit--secondary { background-color: #f0eee8; }

.shell-modal-submit:hover,
.shell-modal-submit:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.shell-modal-submit:active { translate: 0 3px; }

.shell-modal-submit:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

#steam-room-join-notice {
    background-color: rgba(22, 21, 19, 0.96);
    color: #f0eee8;
    border-width: 1px;
    border-color: #7b7872;
}
