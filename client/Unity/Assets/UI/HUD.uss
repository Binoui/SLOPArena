/* Gameplay HUD: stable match readouts, player identity, and ability feedback. */

.hud-root {
    flex-grow: 1;
    pointer-events: none;
}

/* Solo's start is printed like a fight poster, above the fighters. */
.solo-countdown {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}

.solo-countdown-anchor {
    position: absolute;
    left: 50%;
    top: 32%;
    translate: -50% -50%;
    width: 2000px;
    height: 800px;
    align-items: center;
    justify-content: center;
}

/* Fight flyer: a paper card in an ink frame with a hard ink shadow, taped up, printed
   slightly off-register in Orange. SLOP IT OUT is the yellow poster with the bomb as its O. */
.solo-countdown-stamp {
    flex-shrink: 0;
    transform-origin: center;
}

.solo-countdown-shadow,
.solo-countdown-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.solo-countdown-shadow {
    left: 14px;
    top: 14px;
    right: -14px;
    bottom: -14px;
    background-color: #1B1A18;
}

.solo-countdown-card {
    background-color: #F0EEE8;
    border-width: 7px;
    border-color: #1B1A18;
}

.solo-countdown-tape {
    position: absolute;
    width: 92px;
    height: 28px;
    background-color: rgba(255, 204, 34, 0.92);
    border-width: 2px;
    border-color: rgba(27, 26, 24, 0.35);
    rotate: -28deg;
}

.solo-countdown-tape--top {
    left: -34px;
    top: -6px;
}

.solo-countdown-tape--bottom {
    right: -34px;
    bottom: -6px;
}

.solo-countdown-words {
    padding: 14px 56px 10px 56px;
}

.solo-countdown-title,
.solo-countdown-print,
.solo-countdown-mark-text {
    margin: 0;
    padding: 0;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-center;
    font-size: 110px;
    white-space: nowrap;
    color: #1B1A18;
    flex-shrink: 0;
}

.solo-countdown-print {
    position: absolute;
    left: 56px;
    right: 56px;
    top: 14px;
    bottom: 10px;
    color: #E05C2A;
    translate: 6px 6px;
}

.solo-countdown-mark {
    display: none;
    flex-direction: row;
    align-items: center;
    padding: 18px 60px 12px 60px;
}

.solo-countdown-mark-text {
    font-size: 104px;
}

.solo-countdown-bomb {
    flex-shrink: 0;
    width: 102px;
    height: 102px;
    margin: -22px 2px 0 -8px;
    background-image: url("SlopArenaIcon.png");
    -unity-background-scale-mode: scale-to-fit;
}

.solo-countdown--number .solo-countdown-words {
    padding: 0 58px;
}

.solo-countdown--number .solo-countdown-print {
    left: 58px;
    right: 58px;
    top: 0;
    bottom: 0;
}

.solo-countdown--number .solo-countdown-title,
.solo-countdown--number .solo-countdown-print {
    font-size: 240px;
}

.solo-countdown--start .solo-countdown-card {
    background-color: #FFCC22;
}

.solo-countdown--start .solo-countdown-tape {
    background-color: rgba(240, 238, 232, 0.92);
}

.solo-countdown--start .solo-countdown-title,
.solo-countdown--start .solo-countdown-print {
    font-size: 84px;
}

.solo-countdown--mark .solo-countdown-words {
    display: none;
}

.solo-countdown--mark .solo-countdown-mark {
    display: flex;
}


/* Multiplayer-safe left stack: one stable row per roster member. */
.solo-end {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    pointer-events: none;
}

.solo-end-anchor {
    position: absolute;
    left: 50%;
    top: 34%;
    translate: -50% -50%;
    width: 2000px;
    height: 900px;
    align-items: center;
    justify-content: center;
}

/* The finish poster bookends the start flyer: a taped portrait slip and a yellow declaration,
   both in the heavy Ink frame with a hard Ink shadow; the headline is printed off-register in Orange. */
.solo-end-poster {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    rotate: -3deg;
    transform-origin: center;
}

.solo-end-shadow,
.solo-end-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.solo-end-shadow {
    left: 14px;
    top: 14px;
    right: -14px;
    bottom: -14px;
    background-color: #1B1A18;
}

.solo-end-card {
    border-width: 7px;
    border-color: #1B1A18;
}

.solo-end-card--slip { background-color: #F0EEE8; }
.solo-end-card--declaration { background-color: #FFCC22; }

.solo-end-tape {
    position: absolute;
    width: 92px;
    height: 28px;
    background-color: rgba(240, 238, 232, 0.92);
    border-width: 2px;
    border-color: rgba(27, 26, 24, 0.35);
    rotate: -28deg;
}

.solo-end-tape--slip {
    left: 72px;
    top: -14px;
    rotate: 6deg;
    background-color: rgba(255, 204, 34, 0.92);
}

.solo-end-tape--top { left: -34px; top: -6px; }
.solo-end-tape--bottom { right: -34px; bottom: -6px; }

.solo-end-portrait-slip {
    width: 246px;
    margin-right: 30px;
    padding: 16px 16px 10px 16px;
    rotate: 5deg;
    flex-shrink: 0;
}

.solo-end-portraits {
    height: 222px;
    flex-direction: row;
    justify-content: center;
}

.solo-end-portrait {
    width: 214px;
    height: 222px;
}

.solo-end-other-portrait {
    display: none;
    width: 107px;
    height: 222px;
}

.solo-end-name {
    margin: 6px 0 0 0;
    padding: 0;
    font-size: 30px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-center;
    color: #1B1A18;
    white-space: nowrap;
}

.solo-end-declaration {
    padding: 22px 40px 28px 40px;
    flex-shrink: 0;
}

.solo-end-headline {
    flex-shrink: 0;
    position: relative;
}

.solo-end-title,
.solo-end-print {
    margin: 0;
    padding: 0;
    font-size: 108px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
    flex-shrink: 0;
}

.solo-end-title { color: #1B1A18; }
.solo-end-print { position: absolute; left: 0; top: 0; color: #E05C2A; translate: 6px 6px; }

.solo-end-outcome {
    flex-shrink: 0;
    align-self: flex-start;
    margin: 12px 0 0 0;
    padding: 6px 18px;
    background-color: #1B1A18;
    color: #FFCC22;
    font-size: 40px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
}

.solo-end--shared .solo-end-card--declaration { background-color: #F0EEE8; }
.solo-end--shared .solo-end-portrait { width: 107px; }
.solo-end--shared .solo-end-other-portrait { display: flex; }
.solo-end--shared .solo-end-name { font-size: 20px; white-space: normal; }
.solo-end--team .solo-end-portrait-slip { display: none; }

.player-billboard {
    position: absolute;
    left: 18px;
    right: auto;
    top: 18px;
    bottom: auto;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
}

.billboard-card {
    position: relative;
    width: 330px;
    height: 120px;
    margin: 0;
    margin-bottom: 16px;
    overflow: visible;
    flex-direction: row;
    align-items: stretch;
    background-color: #1B1A18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}

.stock-toast-player {
    position: absolute;
    left: 350px;
    top: 14px;
    padding: 6px 22px 12px 22px;
    rotate: -5deg;
    transform-origin: left center;
}

.stock-toast-shadow,
.stock-toast-card {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.stock-toast-shadow {
    left: 7px;
    top: 7px;
    right: -7px;
    bottom: -7px;
    background-color: #1B1A18;
}

.stock-toast-card {
    background-color: #F0EEE8;
    border-width: 4px;
    border-bottom-width: 8px;
    border-color: #1B1A18;
}

.stock-toast-tape {
    position: absolute;
    left: -18px;
    top: -4px;
    width: 54px;
    height: 17px;
    background-color: rgba(255, 204, 34, 0.92);
    border-width: 1px;
    border-color: rgba(27, 26, 24, 0.35);
    rotate: -28deg;
}

.stock-toast-headline {
    position: relative;
}

.stock-toast-title,
.stock-toast-print {
    margin: 0;
    padding: 0;
    font-size: 58px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
    color: #1B1A18;
}

.stock-toast-print {
    position: absolute;
    left: 0;
    top: 0;
    color: #E05C2A;
    translate: 4px 4px;
}

.stock-toast-detail {
    margin: 0;
    padding: 0;
    color: #1B1A18;
    font-size: 17px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-text-align: middle-left;
    white-space: nowrap;
}

/* The last life: the same card printed in reverse, Ink with Paper lettering. */
.stock-toast-player--out .stock-toast-card { background-color: #1B1A18; border-color: #F0EEE8; }
.stock-toast-player--out .stock-toast-title,
.stock-toast-player--out .stock-toast-detail { color: #F0EEE8; }

.billboard-left {
    padding-left: 108px;
}


.billboard-card.eliminated .fighter-portrait {
    opacity: 0.5;
}


.portrait-frame {
    position: absolute;
    left: -3px;
    top: -5px;
    width: 100px;
    height: 120px;
    overflow: hidden;
    border-width: 2px;
    border-color: #F0EEE8;
    background-color: #e05c2a;
    rotate: -2deg;
}



.portrait-missing {
    opacity: 0.2;
}

.fighter-portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-background-scale-mode: scale-and-crop;
}

.fighter-copy {
    flex-grow: 1;
    min-width: 0;
    flex-direction: column;
    align-items: stretch;
    padding: 6px 10px 2px 6px;
}

.fighter-details {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}


.fighter-tape {
    flex-direction: row;
    align-items: center;
    align-self: flex-start;
    background-color: #F0EEE8;
    rotate: -2deg;
}


.billboard-card .badge {
    min-width: 34px;
    height: 22px;
    padding: 1px 5px;
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #161513;
}


.fighter-name {
    margin-left: 8px;
    height: 22px;
    font-size: 14px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #F0EEE8;
    -unity-text-align: middle-left;
}




.billboard-card .overhead-damage {
    flex-shrink: 0;
    height: 56px;
    margin: 0;
    padding: 0;
    font-size: 54px;
    white-space: nowrap;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #161513;
    color: #F0EEE8;
    transition-property: color, translate;
    transition-duration: 0.12s;
}

.billboard-card .overhead-damage.damage-hit {
    translate: 0 -3px;
}

.stock-row {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    border-top-width: 1px;
    border-top-color: #7B7872;
}

.stock-label {
    min-width: 45px;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: #F0EEE8;
}

.stock-tickets {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
}

.stock-icon {
    width: 16px;
    height: 12px;
    flex-shrink: 0;
    margin-left: 6px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #F0EEE8;
}

.stock-icon.lost {
    background-color: #1B1A18;
    border-color: #7B7872;
}

.stock-strike {
    position: absolute;
    display: none;
    left: 0;
    top: 3px;
    width: 12px;
    height: 2px;
    rotate: -35deg;
    background-color: #7B7872;
}

.stock-icon.lost .stock-strike {
    display: flex;
}

.many-stocks .stock-icon {
    width: 11px;
    height: 10px;
    margin-left: 3px;
}

.many-stocks .stock-strike {
    width: 7px;
    top: 2px;
}

.stock-count {
    min-width: 28px;
    margin: 0;
    padding: 0;
    font-size: 18px;
    color: #F0EEE8;
    -unity-font-style: bold;
}

/* Move keys: a paper tab per normal over a raised ink key per special.
   Depth is state. A ready key stands on its offset plate; it sinks while its
   move runs or cools down, refills, then pops back up with a brief yellow edge. */
.move-deck {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    height: 132px;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.move-pairs {
    position: relative;
    flex-direction: row;
    flex-shrink: 0;
    transform-origin: right bottom;
}

.move-pair {
    position: relative;
    width: 68px;
    margin: 0 4px;
    flex-shrink: 0;
    flex-direction: column;
    overflow: visible;
}

.slot {
    position: relative;
    flex-shrink: 0;
    overflow: visible;
}

.normal-slot {
    width: 67px;
    height: 37px;
}

.special-slot {
    width: 68px;
    height: 68px;
    margin-top: 8px;
}

.slot-plate {
    position: absolute;
    left: 3px;
    top: 3px;
    width: 64px;
    height: 34px;
    background-color: #E05C2A;
    border-width: 2px;
    border-color: #161513;
}

.special-slot .slot-plate {
    left: 4px;
    top: 4px;
    height: 64px;
    background-color: #39A9FF;
    border-width: 2px;
    border-color: #161513;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.slot.locked .slot-plate {
    display: none;
}

.slot-face {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 34px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
    transition-property: translate, border-color;
    transition-duration: 0.07s;
}

.special-slot .slot-face {
    height: 64px;
    background-color: #1B1A18;
    border-color: #F0EEE8;
}

.normal-slot.in-use .slot-face,
.normal-slot.on-cooldown .slot-face {
    translate: 3px 3px;
}

.special-slot.in-use .slot-face,
.special-slot.on-cooldown .slot-face {
    translate: 4px 4px;
}

.special-slot.on-cooldown .slot-face {
    border-color: #6F6A73;
}

.special-slot.ready-pulse .slot-face {
    translate: -1px -1px;
    border-color: #FFCC22;
}

.slot.quiet-feedback .slot-face {
    transition-duration: 0s;
}

.special-slot.quiet-feedback.ready-pulse .slot-face {
    translate: 0 0;
}

.slot-name {
    display: none;
}

.slot-content {
    position: absolute;
    left: 26px;
    top: 0;
    width: 30px;
    height: 30px;
}

.special-slot .slot-content {
    left: 2px;
    top: 2px;
    width: 56px;
    height: 56px;
}

.slot-icon-inner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    transition-property: opacity;
    transition-duration: 0.1s;
}

.slot.on-cooldown .slot-icon-inner {
    opacity: 0.3;
}

.slot.locked .slot-icon-inner {
    opacity: 0.35;
}

/* Refill: grows from the bottom as the cooldown elapses (height set by HUDManager). */
.slot-cooldown {
    position: absolute;
    display: none;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(57, 169, 255, 0.2);
    border-top-width: 2px;
    border-color: #39A9FF;
}

.slot-timer {
    position: absolute;
    display: none;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    color: #F0EEE8;
}

.normal-slot .slot-timer {
    font-size: 14px;
}

/* Cooldown completion is shown by the pop and yellow edge, not a text tag. */
.slot-ready {
    display: none;
}

.slot-prompt {
    position: absolute;
    left: 1px;
    top: 0;
    min-width: 22px;
    height: 30px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.slot-prompt-image {
    display: none;
    width: 22px;
    height: 22px;
}

.slot-key-label {
    margin: 0;
    padding: 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    color: #1B1A18;
}

.special-slot .slot-prompt {
    left: -9px;
    top: -9px;
    min-width: 0;
    height: auto;
    rotate: -4deg;
}

.special-slot .slot-key-label {
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    font-size: 12px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #161513;
}

.controller-prompts .special-slot .slot-prompt {
    display: none;
}

.move-tooltip {
    position: absolute;
    display: none;
    top: -34px;
    width: 240px;
    height: 26px;
    margin: 0;
    padding: 0 8px;
    background-color: #F0EEE8;
    color: #1B1A18;
    border-width: 1px;
    border-color: #1B1A18;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.modifier-rail {
    display: none;
}

/* Controller only: specials share each face button behind the modifier. */
.modifier-prompt {
    position: absolute;
    left: -58px;
    top: 63px;
    height: 28px;
    min-width: 48px;
    padding: 0 6px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #1B1A18;
    transition-property: background-color;
    transition-duration: 0.1s;
}

.keyboard-modifier {
    display: none;
}

.modifier-button {
    width: 34px;
    height: 24px;
    background-color: #1B1A18;
}

.modifier-key {
    margin: 0;
    padding: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: #1B1A18;
}

.modifier-plus {
    margin: 0;
    padding: 0 0 0 3px;
    color: #1B1A18;
    font-size: 16px;
    -unity-font-style: bold;
}

.modifier-held .modifier-prompt,
.modifier-held .special-slot .slot-plate {
    background-color: #FFCC22;
}

/* Locked marker keeps its anchor when the optional damage tab is hidden. */
.target-lock {
    position: absolute;
    display: none;
    width: 100px;
    height: 58px;
}

.target-lock.visible {
    display: flex;
}

.target-lock-readout {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 0;
    height: 28px;
    padding-left: 6px;
    padding-right: 6px;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: #1B1A18;
}

.target-lock.damage-hidden .target-lock-readout {
    display: none;
}

.target-lock-damage {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #F0EEE8;
}

.target-lock-percent {
    margin: 0;
    margin-left: 2px;
    padding: 0;
    flex-shrink: 0;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    translate: 0 3px;
    color: #F0EEE8;
}

.target-lock-marker {
    position: absolute;
    left: 29px;
    bottom: 0;
    width: 42px;
    height: 26px;
}

.target-lock-bracket {
    position: absolute;
    top: 0;
    width: 10px;
    height: 15px;
    border-top-width: 3px;
    border-top-color: #EF4444;
}

.target-lock-bracket-left {
    left: 0;
    border-left-width: 3px;
    border-left-color: #EF4444;
}

.target-lock-bracket-right {
    right: 0;
    border-right-width: 3px;
    border-right-color: #EF4444;
}

.target-lock-pointer {
    position: absolute;
    top: 12px;
    width: 15px;
    height: 4px;
    background-color: #EF4444;
}

.target-lock-pointer-left {
    left: 8px;
    rotate: 45deg;
}

.target-lock-pointer-right {
    right: 8px;
    rotate: -45deg;
}

/* Match overlays share the frontend control language, not gameplay colors. */
.match-pause-cover {
    background-color: rgba(22, 21, 19, 0.72);
}

/* The same modal card as the frontend MENU (FrontendShell.uss .shell-escape-*):
   left title, yellow Resume first, paper secondaries, hard print offset. */
.match-pause-box {
    width: 360px;
    max-width: 90%;
    padding: 24px;
    background-color: #f0eee8;
    border-width: 3px;
    border-right-width: 6px;
    border-bottom-width: 8px;
    border-color: #161513;
}

.match-pause-title {
    margin-bottom: 18px;
    color: #1b1a18;
    font-size: 36px;
    -unity-text-align: middle-left;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.match-pause-action {
    min-height: 52px;
    margin: 0 0 10px 0;
    padding: 0 18px;
    background-color: #f0eee8;
    color: #1b1a18;
    font-size: 18px;
    border-width: 3px;
    border-right-width: 5px;
    border-bottom-width: 6px;
    border-color: #161513;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.match-pause-action--primary { background-color: #ffcc22; }

.match-pause-error {
    margin-bottom: 10px;
    color: #9b3028;
    font-size: 16px;
}

/* Focus: a paper button turns ink with a yellow frame; the yellow primary
   keeps its yellow and takes a heavier ink frame. */
.match-pause-action:hover,
.match-pause-action:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.match-pause-action--primary:hover,
.match-pause-action--primary:focus {
    background-color: #ffcc22;
    color: #1b1a18;
    border-left-width: 4px;
    border-top-width: 4px;
    border-color: #161513;
}

.match-pause-action:active { translate: 0 3px; }

.match-pause-action:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

.shell-modal {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(22, 21, 19, 0.8);
}

.shell-modal-box {
    min-width: 320px;
    max-width: 560px;
    padding: 20px 24px;
    background-color: #f0eee8;
    border-width: 3px;
    border-color: #161513;
    border-bottom-width: 8px;
}

.shell-modal-title {
    color: #1b1a18;
    font-size: 24px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    white-space: normal;
}

.shell-modal-help {
    margin-top: 8px;
    margin-bottom: 14px;
    color: #252422;
    font-size: 15px;
    white-space: normal;
}

.shell-modal-row {
    flex-direction: row;
    align-items: stretch;
}

.shell-modal-submit {
    flex-grow: 1;
    min-height: 40px;
    margin-right: 6px;
    padding: 0 16px;
    background-color: #ffcc22;
    color: #1b1a18;
    border-width: 2px;
    border-color: #161513;
    border-bottom-width: 4px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
}

.shell-modal-submit--secondary { background-color: #f0eee8; }

.shell-modal-submit:hover,
.shell-modal-submit:focus {
    background-color: #1b1a18;
    color: #f0eee8;
    border-color: #ffcc22;
}

.shell-modal-submit:active { translate: 0 3px; }

.shell-modal-submit:disabled {
    background-color: #252422;
    color: #b7b4ad;
    border-color: #7b7872;
    translate: 0 0;
}

#steam-room-join-notice {
    background-color: rgba(22, 21, 19, 0.96);
    color: #f0eee8;
    border-width: 1px;
    border-color: #7b7872;
}

/* Online fight cards name the player; the fighter becomes a quiet tag. */
.fighter-name--player {
    max-width: 120px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.fighter-character {
    margin-left: 7px;
    height: 22px;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-definition: url("../Fonts/SpaceMono.asset");
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    color: #A8A49C;
    white-space: nowrap;
}

/* Speech slips: Room chat from the fight, pasted over the speaker. */
.chat-speech-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.chat-slip {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: center bottom;
}

.chat-slip--card {
    transform-origin: left center;
}

.chat-slip__shadow {
    position: absolute;
    left: 4px;
    top: 4px;
    right: -4px;
    bottom: -4px;
    background-color: #1B1A18;
}

.chat-slip__box {
    max-width: 300px;
    padding: 10px 12px 9px 12px;
    background-color: #F0EEE8;
    border-width: 2px;
    border-color: #1B1A18;
}

.chat-slip__text {
    margin: 0;
    padding: 0;
    font-size: 17px;
    white-space: normal;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: #1B1A18;
}

.chat-slip__who {
    position: absolute;
    left: 8px;
    top: -15px;
    margin: 0;
    padding: 3px 6px 2px 6px;
    border-width: 2px;
    border-color: #1B1A18;
    font-size: 11px;
    letter-spacing: 0.4px;
    -unity-font-definition: url("../Fonts/ArchivoBlack.asset");
    -unity-font-style: normal;
    color: #1B1A18;
    white-space: nowrap;
}

/* A turned square: its lower edges are the tail, its upper half hides the box border. */
.chat-slip__tail {
    position: absolute;
    left: 50%;
    bottom: -7px;
    width: 13px;
    height: 13px;
    margin-left: -7px;
    background-color: #F0EEE8;
    border-color: #1B1A18;
    border-right-width: 2px;
    border-bottom-width: 2px;
    rotate: 45deg;
}

.chat-slip--card .chat-slip__tail {
    left: -7px;
    top: 50%;
    bottom: auto;
    margin-left: 0;
    margin-top: -7px;
    border-right-width: 0;
    border-left-width: 2px;
}
