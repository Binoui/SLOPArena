"""Start with the seeded take. Run with ./py author.py after adding the requested motion."""
from genra.brief import Brief
from genra.clip import Clip, Pose
from genra.flow import flow, Accent, key_drift
from genra.solve import solve, carry, pin, track, hold_grip, two_bone, two_hand_grip
from genra.checks import check_clip, format_report

b = Brief('brief.json')
rig = b.rig
if b.get('approved_keys') and b.get('authoring_stage', 'full') == 'full':
    clip, report = flow(b)
    print(report)
else:
    clip = Clip.load(rig, 'result.json', frame=b.entry_frame)
keys = {tick: clip.pose(tick) for tick in b.key_beats}

