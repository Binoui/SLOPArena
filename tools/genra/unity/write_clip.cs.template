    for (int i = 0; i < paths.Length; i++) { goal[i] = source.bones[i].position; goalRotation[i] = source.bones[i].rotation; }
    handler.GetHumanPose(ref humanPose);
    bodyT[tick] = humanPose.bodyPosition; bodyQ[tick] = humanPose.bodyRotation;
    var full = (float[])humanPose.muscles.Clone();
