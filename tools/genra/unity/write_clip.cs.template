  // mapped bones, so those are reported instead of animated.
  bool InBetween(UnityEngine.Transform t) {
    bool above = false;
    for (var p = t.parent; p != null && !above; p = p.parent) above = human.Contains(p);
    if (!above) return false;
    foreach (var c in t.GetComponentsInChildren<UnityEngine.Transform>(true)) if (c != t && human.Contains(c)) return true;
    return false;
  }
  var generic = new System.Collections.Generic.List<int>(); var inBetween = new System.Collections.Generic.List<string>(); var mapped = new System.Collections.Generic.List<string>();
  for (int i = 0; i < paths.Length; i++) {
    if (human.Contains(source.bones[i])) mapped.Add(paths[i]);
    else if (InBetween(source.bones[i])) inBetween.Add(paths[i]);
    else generic.Add(i);
  }

  // 2. The clip. HumanTrait names finger muscles "Left Index 1 Stretched"; clips bind "LeftHand.Index.1 Stretched".
  string MuscleAttribute(string muscle) {
    foreach (var side in new[] { "Left", "Right" })
      foreach (var finger in new[] { "Thumb", "Index", "Middle", "Ring", "Little" })
        if (muscle.StartsWith(side + " " + finger + " ")) return side + "Hand." + finger + "." + muscle.Substring(side.Length + finger.Length + 2);
    return muscle;
  }
