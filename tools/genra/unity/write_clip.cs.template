      int pivot = col; for (int row = col + 1; row < n; row++) if (System.Math.Abs(a[row, col]) > System.Math.Abs(a[pivot, col])) pivot = row;
      for (int k = 0; k < n; k++) { var tmp = a[col, k]; a[col, k] = a[pivot, k]; a[pivot, k] = tmp; }
      { var tmp = b[col]; b[col] = b[pivot]; b[pivot] = tmp; }
      for (int row = col + 1; row < n; row++) { var f = a[row, col] / a[col, col]; for (int k = col; k < n; k++) a[row, k] -= f * a[col, k]; b[row] -= f * b[col]; }
    }
    var x = new double[n];
    for (int row = n - 1; row >= 0; row--) { var s = b[row]; for (int k = row + 1; k < n; k++) s -= a[row, k] * x[k]; x[row] = s / a[row, row]; }
