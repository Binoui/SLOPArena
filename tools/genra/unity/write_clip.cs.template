  var bakes = new System.Collections.Generic.List<object>();  // conversions: the mesh as the game plays it
  if (compareClip == null) {
    foreach (var tick in bakeTicks) {
      Runtime(result, tick / (float)fps); var mesh = Skin(player);
      var renderers = new System.Collections.Generic.List<object>();
