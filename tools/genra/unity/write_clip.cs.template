  if (assetPath == null) temporary.Add(result);
  return new { output, data.humanMotion, data.curves, mapped = mapped.Count, generic = generic.Count, inBetween = inBetween.Count, origin = data.originBodyOffset, data.asset };
} finally {
  foreach (var g in spawned) if (g != null) UnityEngine.Object.DestroyImmediate(g);
  foreach (var o in temporary) if (o != null) UnityEngine.Object.DestroyImmediate(o);
  UnityEditor.SceneManagement.EditorSceneManager.ClosePreviewScene(scene);
}
