string compareId = job["compare"]?.Type == Newtonsoft.Json.Linq.JTokenType.String ? (string)job["compare"] : null;
var bakeTicks = job["bakeTicks"].ToObject<int[]>();
string assetPath = job["asset"]?.Type == Newtonsoft.Json.Linq.JTokenType.String ? (string)job["asset"] : null;
if (assetPath != null && (!assetPath.StartsWith("Assets/") || !assetPath.EndsWith(".anim") || assetPath.Contains("..")))
  throw new System.Exception("Asset path must be a new Assets/... .anim path: " + assetPath);
if (assetPath != null && UnityEditor.AssetDatabase.LoadMainAssetAtPath(assetPath) != null) throw new System.Exception("Refusing to overwrite " + assetPath);

var catalog = UnityEditor.AssetDatabase.LoadMainAssetAtPath("Assets/CharacterPackages/" + package + "/CharacterAssetCatalog.asset");
if (catalog == null) throw new System.Exception("No catalog for " + package);
var catalogObject = new UnityEditor.SerializedObject(catalog);
var prefab = (UnityEngine.GameObject)catalogObject.FindProperty("_rig").objectReferenceValue;
