  var origin = UnityEngine.Vector3.zero;
  float[][] referencePositions = null;
  if (referenceClip != null) {
    var target = Runtime(referenceClip, referenceTime);
    referencePositions = target.positions;
    var provisional = Build(UnityEngine.Vector3.zero);
    temporary.Add(provisional);
    origin = target.body - Runtime(provisional, 0f).body;
  }
  var result = Build(origin);

  var newSample = new float[ticks][][]; var newRuntime = new float[ticks][][];
  var compareSample = compareClip != null ? new float[ticks][][] : null; var compareRuntime = compareClip != null ? new float[ticks][][] : null;
  for (int tick = 0; tick < ticks; tick++) {
    float time = tick / (float)fps;
    newSample[tick] = Sampled(result, time);
    newRuntime[tick] = Runtime(result, time).positions;
    if (compareClip != null) { compareSample[tick] = Sampled(compareClip, time); compareRuntime[tick] = Runtime(compareClip, time).positions; }
  }
