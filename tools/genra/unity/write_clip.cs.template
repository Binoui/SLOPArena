       UnityEngine.HumanBodyBones.Head, UnityEngine.HumanBodyBones.LeftEye, UnityEngine.HumanBodyBones.RightEye, UnityEngine.HumanBodyBones.Jaw),
    Of(UnityEngine.HumanBodyBones.LeftUpperLeg, UnityEngine.HumanBodyBones.LeftLowerLeg, UnityEngine.HumanBodyBones.LeftFoot, UnityEngine.HumanBodyBones.LeftToes),
    Of(UnityEngine.HumanBodyBones.RightUpperLeg, UnityEngine.HumanBodyBones.RightLowerLeg, UnityEngine.HumanBodyBones.RightFoot, UnityEngine.HumanBodyBones.RightToes),
    Of(UnityEngine.HumanBodyBones.LeftShoulder, UnityEngine.HumanBodyBones.LeftUpperArm, UnityEngine.HumanBodyBones.LeftLowerArm, UnityEngine.HumanBodyBones.LeftHand),
    Of(UnityEngine.HumanBodyBones.RightShoulder, UnityEngine.HumanBodyBones.RightUpperArm, UnityEngine.HumanBodyBones.RightLowerArm, UnityEngine.HumanBodyBones.RightHand),
    Range(UnityEngine.HumanBodyBones.LeftThumbProximal, UnityEngine.HumanBodyBones.LeftLittleDistal),
    Range(UnityEngine.HumanBodyBones.RightThumbProximal, UnityEngine.HumanBodyBones.RightLittleDistal) };
  var indexOf = new System.Collections.Generic.Dictionary<UnityEngine.Transform, int>();
  for (int i = 0; i < paths.Length; i++) indexOf[source.bones[i]] = i;
  var chainMuscles = new int[chains.Length][]; var chainTargets = new int[chains.Length][]; var chainTurns = new int[chains.Length][];
  for (int c = 0; c < chains.Length; c++) {
    var set = new System.Collections.Generic.HashSet<int>(chains[c]);
    var m = new System.Collections.Generic.List<int>();
    foreach (var b in chains[c]) if (source.animator.GetBoneTransform((UnityEngine.HumanBodyBones)b) != null)
      for (int dof = 0; dof < 3; dof++) { int muscle = UnityEngine.HumanTrait.MuscleFromBone(b, dof); if (muscle >= 0) m.Add(muscle); }
    var targets = new System.Collections.Generic.List<int>();
    for (int i = 0; i < paths.Length; i++) if (set.Contains(Owner(source.bones[i].parent))) targets.Add(i);
    var turns = new System.Collections.Generic.List<int>();  // the chain's own bones: their world orientation
    foreach (var b in chains[c]) { var t = source.animator.GetBoneTransform((UnityEngine.HumanBodyBones)b); if (t != null && indexOf.TryGetValue(t, out int k)) turns.Add(k); }
    chainMuscles[c] = m.ToArray(); chainTargets[c] = targets.ToArray(); chainTurns[c] = turns.ToArray();
  }
  var goal = new UnityEngine.Vector3[paths.Length]; var goalRotation = new UnityEngine.Quaternion[paths.Length];
  var trial = new UnityEngine.HumanPose();
  const float lever = 0.05f;  // orientation error as the motion of points 5 cm along two bone axes
  float[] Residual(int tick, float[] full, int[] targets, int[] turns) {
    trial.bodyPosition = bodyT[tick]; trial.bodyRotation = bodyQ[tick]; trial.muscles = full;
    handler.SetHumanPose(ref trial);
    var r = new float[targets.Length * 3 + turns.Length * 6];
    for (int i = 0; i < targets.Length; i++) { var d = source.bones[targets[i]].position - goal[targets[i]]; r[3 * i] = d.x; r[3 * i + 1] = d.y; r[3 * i + 2] = d.z; }
    int o = targets.Length * 3;
    for (int i = 0; i < turns.Length; i++) {
      var a = source.bones[turns[i]].rotation; var g = goalRotation[turns[i]];
      var dx = (a * UnityEngine.Vector3.right - g * UnityEngine.Vector3.right) * lever; var dy = (a * UnityEngine.Vector3.up - g * UnityEngine.Vector3.up) * lever;
      r[o + 6 * i] = dx.x; r[o + 6 * i + 1] = dx.y; r[o + 6 * i + 2] = dx.z; r[o + 6 * i + 3] = dy.x; r[o + 6 * i + 4] = dy.y; r[o + 6 * i + 5] = dy.z;
    }
