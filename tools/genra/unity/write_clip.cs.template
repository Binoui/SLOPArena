var package = (string)job["package"];
var name = (string)job["name"];
int fps = (int)job["fps"];
var paths = job["paths"].ToObject<string[]>();
var locals = job["local"].ToObject<float[][][]>();  // [tick][path] Unity local px py pz qx qy qz qw sx sy sz
int ticks = locals.Length;
