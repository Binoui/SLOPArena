// genra real-character render: candidate or bound clips on the package's catalog prefab (or the rig pack's candidate
// prefab, job["prefab"]), played as the game plays them.
// Rendered by tools/genra/unity_clip.py ({{JOB}} {{OUTPUT}}) and run with the gateway's eval_file in Edit Mode.
// Everything lives in a preview scene and is destroyed afterwards: no asset, scene or binding changes. Each clip is
// stretched over the stage's ticks the way PlayerRenderer does (speed = baked frames / stage ticks), with Animancer and
// root motion off, runtime weapon attachments and the actual meshes and materials. Skinned meshes are drawn from
// BakeMesh copies so the preview never shows a stale GPU skinning cache.
// job["rows"] (timeline) instead plays clip sequences the way PlayerRenderer drives them: each event crossfades to a
// clip at a tick (fade seconds, start time, speed or `ticks` to stretch it like an ability), the clock advances one
// 60 Hz tick per frame, and `moves` carry the fighter forward so a dash travels; the cameras follow it.
var job = Newtonsoft.Json.Linq.JObject.Parse(System.IO.File.ReadAllText("{{JOB}}"));
var output = "{{OUTPUT}}";
if (UnityEditor.EditorApplication.isPlaying) throw new System.Exception("genra render requires Edit Mode");
var started = System.DateTime.UtcNow;
var package = (string)job["package"];
int ticks = (int)job["ticks"];
int size = (int)job["size"];
var frames = (string)job["frames"];
var background = job["background"].ToObject<float[]>();

var catalog = UnityEditor.AssetDatabase.LoadMainAssetAtPath("Assets/CharacterPackages/" + package + "/CharacterAssetCatalog.asset");
if (catalog == null) throw new System.Exception("No catalog for " + package);
var catalogObject = new UnityEditor.SerializedObject(catalog);
// A candidate pack (unity_rigpack.py --prefab) names its own unbound prefab; otherwise the catalog's _rig.
string prefabPath = job["prefab"]?.Type == Newtonsoft.Json.Linq.JTokenType.String ? (string)job["prefab"] : null;
var prefab = !string.IsNullOrEmpty(prefabPath)
  ? UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>(prefabPath)
  : (UnityEngine.GameObject)catalogObject.FindProperty("_rig").objectReferenceValue;
if (prefab == null) throw new System.Exception("No prefab " + (prefabPath ?? "_rig of " + package));
UnityEngine.AnimationClip Bound(string semantic) {
  var bindings = catalogObject.FindProperty("_bindings");
  for (int i = 0; i < bindings.arraySize; i++) {
    var entry = bindings.GetArrayElementAtIndex(i);
    if (entry.FindPropertyRelative("_semanticId").stringValue == semantic)
      return (UnityEngine.AnimationClip)entry.FindPropertyRelative("_clip").objectReferenceValue;
  }
  throw new System.Exception("Missing bound clip " + semantic);
}
UnityEngine.AnimationClip LoadClip(string source) {  // "Assets/...anim", or "Assets/...fbx|Take" for one clip of a model
  var parts = source.Split('|');
  foreach (var asset in UnityEditor.AssetDatabase.LoadAllAssetsAtPath(parts[0])) {
    var clip = asset as UnityEngine.AnimationClip;
    if (clip != null && !clip.name.StartsWith("__preview__") && (parts.Length == 1 || clip.name == parts[1])) return clip;
  }
  return null;
}
UnityEngine.AnimationClip Resolve(Newtonsoft.Json.Linq.JToken c) {
  string asset = c["asset"]?.Type == Newtonsoft.Json.Linq.JTokenType.String ? (string)c["asset"] : null;
  var clip = asset != null ? LoadClip(asset) : Bound((string)c["semanticId"]);
  if (clip == null) throw new System.Exception("Missing clip " + (asset ?? (string)c["semanticId"]));
  return clip;
}
// PlayerRenderer: baked frames = ceil(length * 60), speed = frames / stage ticks, time = tick / 60 * speed.
int Baked(UnityEngine.AnimationClip clip) => UnityEngine.Mathf.Max(1, UnityEngine.Mathf.CeilToInt(clip.length * 60f - 0.0001f));
var clips = new System.Collections.Generic.List<(string label, string source, UnityEngine.AnimationClip clip)>();
foreach (var c in job["clips"] ?? new Newtonsoft.Json.Linq.JArray())
  clips.Add(((string)c["label"], (string)(c["asset"] ?? c["semanticId"]), Resolve(c)));

var scene = UnityEditor.SceneManagement.EditorSceneManager.NewPreviewScene();
var temporary = new System.Collections.Generic.List<UnityEngine.Object>();
var previousActive = UnityEngine.RenderTexture.active;
UnityEngine.GameObject Add(UnityEngine.GameObject g) {
  temporary.Add(g);
  UnityEngine.SceneManagement.SceneManager.MoveGameObjectToScene(g, scene);
  g.hideFlags = UnityEngine.HideFlags.HideAndDontSave;
  return g;
}
try {
  var actor = Add((UnityEngine.GameObject)UnityEngine.Object.Instantiate(prefab));
  var animator = actor.GetComponentInChildren<UnityEngine.Animator>(true);
  animator.applyRootMotion = false;
  animator.cullingMode = UnityEngine.AnimatorCullingMode.AlwaysAnimate;
  var animancer = actor.AddComponent<Animancer.AnimancerComponent>();
  animancer.Animator = animator;
  var all = actor.GetComponentsInChildren<UnityEngine.Transform>(true);
  var byPath = new System.Collections.Generic.Dictionary<string, UnityEngine.Transform>();
  foreach (var t in all) byPath[UnityEditor.AnimationUtility.CalculateTransformPath(t, actor.transform)] = t;
  var restT = new UnityEngine.Vector3[all.Length]; var restR = new UnityEngine.Quaternion[all.Length]; var restS = new UnityEngine.Vector3[all.Length];
  for (int i = 0; i < all.Length; i++) { restT[i] = all[i].localPosition; restR[i] = all[i].localRotation; restS[i] = all[i].localScale; }
  var constraints = actor.GetComponentsInChildren<UnityEngine.Animations.RotationConstraint>(true);
  // Presentation springs (Manki's tail, Sir Bonk's cape) run in Play Mode only; step them once per evaluated tick so the
  // preview shows them as the game does (job["springs"] false keeps them at rest). job["travel"] carries a single clip
  // forward (metres per tick, the run's ground speed) so a spring trails as it does while the fighter moves.
  var springs = actor.GetComponentsInChildren<SlopArena.Client.Entities.BoneChainSpring>(true);
  bool simulate = job["springs"]?.Type != Newtonsoft.Json.Linq.JTokenType.Boolean || (bool)job["springs"];
  float travel = job["travel"] != null && job["travel"].Type != Newtonsoft.Json.Linq.JTokenType.Null ? (float)job["travel"] : 0f;
  // The rig pack was snapshotted with the prefab at its own root transform (Bonk's sits 1 m down), so review cameras
  // are placed relative to that pose: they follow only the fighter's travel away from it.
  var basePosition = actor.transform.position;
  float travelled = 0f;
  void StepSprings() { if (simulate) foreach (var s in springs) s.Step(1f / 60f); }
  void ResetSprings() { foreach (var s in springs) s.ResetSimulation(); }

  // Runtime weapon attachments (WeaponAttach): bone.TransformPoint(PositionOffset), bone.rotation * Euler(RotationOffset).
  // A weapon's `shown` tick windows (the brief's props_shown, or a timeline row's) hide it outside them, as the game's hide
  // rules do: a prop that changes hands is drawn once.
  var weapons = new System.Collections.Generic.List<(UnityEngine.Transform bone, UnityEngine.GameObject weapon, UnityEngine.Vector3 position, UnityEngine.Quaternion rotation, string name, int[][] shown)>();
  int[][] Windows(Newtonsoft.Json.Linq.JToken t) => t != null && t.Type == Newtonsoft.Json.Linq.JTokenType.Array ? t.ToObject<int[][]>() : null;
  foreach (var w in job["weapons"]) {
    if (!byPath.TryGetValue((string)w["bone"], out var bone)) throw new System.Exception("Missing weapon bone " + (string)w["bone"]);
    var weaponPrefab = UnityEditor.AssetDatabase.LoadAssetAtPath<UnityEngine.GameObject>((string)w["prefab"]);
    if (weaponPrefab == null) throw new System.Exception("Missing weapon prefab " + (string)w["prefab"]);
    var p = w["positionOffset"].ToObject<float[]>(); var r = w["rotationOffset"].ToObject<float[]>();
    weapons.Add((bone, Add((UnityEngine.GameObject)UnityEngine.Object.Instantiate(weaponPrefab)),
                 new UnityEngine.Vector3(p[0], p[1], p[2]), UnityEngine.Quaternion.Euler(r[0], r[1], r[2]),
                 (string)w["name"] ?? "Weapon" + weapons.Count, Windows(w["shown"])));
  }
  void ShowWeapons(int tick, Newtonsoft.Json.Linq.JToken overrides) {
    foreach (var w in weapons) {
      var windows = (overrides as Newtonsoft.Json.Linq.JObject)?[w.name] is Newtonsoft.Json.Linq.JToken o ? Windows(o) : w.shown;
      bool shown = windows == null;
      if (windows != null) foreach (var s in windows) shown |= tick >= s[0] && tick <= s[1];
      w.weapon.SetActive(shown);
    }
  }

  // Skinned meshes are drawn by rigid copies baked each pose.
  var skins = actor.GetComponentsInChildren<UnityEngine.SkinnedMeshRenderer>(true);
  var copies = new System.Collections.Generic.List<(UnityEngine.SkinnedMeshRenderer skin, UnityEngine.GameObject copy, UnityEngine.Mesh mesh)>();
  foreach (var skin in skins) {
    if (!skin.gameObject.activeInHierarchy || !skin.enabled) continue;
    var copy = Add(new UnityEngine.GameObject("genra_render_" + skin.name));
    var mesh = new UnityEngine.Mesh(); temporary.Add(mesh);
    copy.AddComponent<UnityEngine.MeshFilter>().sharedMesh = mesh;
    copy.AddComponent<UnityEngine.MeshRenderer>().sharedMaterials = skin.sharedMaterials;
    skin.forceRenderingOff = true;
    copies.Add((skin, copy, mesh));
  }

  void Rest() { for (int i = 0; i < all.Length; i++) { all[i].localPosition = restT[i]; all[i].localRotation = restR[i]; all[i].localScale = restS[i]; } }
  void Pose(UnityEngine.AnimationClip clip, float time) {
    Rest();
    actor.transform.position = basePosition + new UnityEngine.Vector3(0f, 0f, travelled);
    var state = animancer.Play(clip, 0f); state.Speed = 0f; state.Time = time; animancer.Evaluate(0f);
    StepSprings();
    Settle();
  }
  void Settle() {
    foreach (var c in constraints) {  // Edit Mode does not evaluate constraints; apply single-source ones as the runtime does
      if (!c.constraintActive || c.weight <= 0f || c.sourceCount != 1) continue;
      var src = c.GetSource(0);
      if (src.sourceTransform != null && src.weight > 0f) c.transform.rotation = src.sourceTransform.rotation * UnityEngine.Quaternion.Euler(c.rotationOffset);
    }
    foreach (var w in weapons) {
      w.weapon.transform.position = w.bone.TransformPoint(w.position);
      w.weapon.transform.rotation = w.bone.rotation * w.rotation;
    }
    foreach (var c in copies) {
      c.skin.BakeMesh(c.mesh, false);
      c.copy.transform.SetPositionAndRotation(c.skin.transform.position, c.skin.transform.rotation);
    }
  }

  var cameraObject = Add(new UnityEngine.GameObject("genra_render_camera"));
  var camera = cameraObject.AddComponent<UnityEngine.Camera>();
  camera.scene = scene;
  camera.orthographic = true;
  camera.clearFlags = UnityEngine.CameraClearFlags.SolidColor;
  camera.backgroundColor = new UnityEngine.Color(background[0], background[1], background[2], 1f);
  camera.nearClipPlane = 0.05f; camera.farClipPlane = 80f;
  var target = new UnityEngine.RenderTexture(size, size, 24) { antiAliasing = 4 }; temporary.Add(target);
  camera.targetTexture = target;
  var pixels = new UnityEngine.Texture2D(size, size, UnityEngine.TextureFormat.RGB24, false); temporary.Add(pixels);
  var key = Add(new UnityEngine.GameObject("genra_render_key")).AddComponent<UnityEngine.Light>();
  key.type = UnityEngine.LightType.Directional; key.intensity = 1.25f; key.shadows = UnityEngine.LightShadows.None;
  var fill = Add(new UnityEngine.GameObject("genra_render_fill")).AddComponent<UnityEngine.Light>();
  fill.type = UnityEngine.LightType.Directional; fill.intensity = 0.55f; fill.shadows = UnityEngine.LightShadows.None;

  var views = new System.Collections.Generic.List<(string name, UnityEngine.Vector3 position, UnityEngine.Quaternion rotation, float size)>();
  foreach (var v in job["views"]) {
    var p = v["position"].ToObject<float[]>(); var f = v["forward"].ToObject<float[]>(); var u = v["up"].ToObject<float[]>();
    views.Add(((string)v["name"], new UnityEngine.Vector3(p[0], p[1], p[2]),
               UnityEngine.Quaternion.LookRotation(new UnityEngine.Vector3(f[0], f[1], f[2]), new UnityEngine.Vector3(u[0], u[1], u[2])), (float)v["size"]));
  }
  void Capture(string label, int tick) {
    foreach (var view in views) {
      camera.transform.SetPositionAndRotation(view.position + (actor.transform.position - basePosition), view.rotation);
      camera.orthographicSize = view.size;
      var right = camera.transform.right; var up = camera.transform.up; var forward = camera.transform.forward;
      key.transform.rotation = UnityEngine.Quaternion.LookRotation(forward - 0.8f * up + 0.35f * right, up);
      fill.transform.rotation = UnityEngine.Quaternion.LookRotation(forward - 0.15f * up - 0.9f * right, up);
      camera.Render();
      UnityEngine.RenderTexture.active = target;
      pixels.ReadPixels(new UnityEngine.Rect(0, 0, size, size), 0, 0);
      pixels.Apply();
      System.IO.File.WriteAllBytes(frames + "/" + label + "/" + view.name + "/" + tick.ToString("D4") + ".png", UnityEngine.ImageConversion.EncodeToPNG(pixels));
    }
  }
  var receipts = new System.Collections.Generic.List<object>();
  foreach (var (label, source, clip) in clips) {
    int baked = Baked(clip);
    float speed = baked / (float)ticks;
    foreach (var view in views) System.IO.Directory.CreateDirectory(frames + "/" + label + "/" + view.name);
    ResetSprings();
    travelled = 0f;
    if (simulate && springs.Length > 0 && clip.isLooping)  // a loop's springs are already swinging when the preview starts
      for (int tick = 0; tick < ticks; tick++) { travelled += travel; Pose(clip, UnityEngine.Mathf.Min(tick / 60f * speed, clip.length)); }
    for (int tick = 0; tick <= ticks; tick++) {
      if (tick > 0) travelled += travel;
      Pose(clip, UnityEngine.Mathf.Min(tick / 60f * speed, clip.length));
      ShowWeapons(tick, null);
      Capture(label, tick);
    }
    actor.transform.position = basePosition;
    travelled = 0f;
    receipts.Add(new { label, source, clip = clip.name, lengthSeconds = clip.length, frameRate = clip.frameRate, bakedFrames = baked, speed, humanMotion = clip.humanMotion });
  }
  foreach (var row in job["rows"] ?? new Newtonsoft.Json.Linq.JArray()) {
    string label = (string)row["label"];
    var events = new System.Collections.Generic.Dictionary<int, Newtonsoft.Json.Linq.JToken>();
    foreach (var e in row["events"]) events[(int)e["tick"]] = e;
    var moves = row["moves"]?.ToObject<float[][]>() ?? new float[0][];  // [first tick, last tick, metres per tick forward]
    foreach (var view in views) System.IO.Directory.CreateDirectory(frames + "/" + label + "/" + view.name);
    Rest();
    actor.transform.position = basePosition;
    animancer.Stop();
    ResetSprings();
    var played = new System.Collections.Generic.List<object>();
    for (int tick = 0; tick <= ticks; tick++) {
      // As in the game, a clip starts on the tick its state changes and that frame already advances one tick.
      if (events.TryGetValue(tick, out var e)) {
        var clip = Resolve(e);
        float fade = e["fade"] != null ? (float)e["fade"] : 0f;
        float speed = e["speed"] != null ? (float)e["speed"] : e["ticks"] != null ? Baked(clip) / (float)e["ticks"] : 1f;
        var state = animancer.Play(clip, fade);
        state.Time = e["time"] != null ? (float)e["time"] : 0f;
        state.Speed = speed;
        played.Add(new { tick, source = (string)(e["asset"] ?? e["semanticId"]), clip = clip.name, fade, speed, looping = clip.isLooping, lengthSeconds = clip.length });
      }
      if (tick > 0) {
        animancer.Evaluate(1f / 60f);
        foreach (var m in moves) if (tick >= m[0] && tick <= m[1]) actor.transform.position += new UnityEngine.Vector3(0f, 0f, m[2]);
      } else animancer.Evaluate(0f);
      StepSprings();
      Settle();
      ShowWeapons(tick, row["props_shown"]);
      Capture(label, tick);
    }
    receipts.Add(new { label, events = played, travelMetres = actor.transform.position.z - basePosition.z });
  }
  camera.targetTexture = null;
  var data = new { package, prefab = UnityEditor.AssetDatabase.GetAssetPath(prefab), ticks, size, frames, clips = receipts,
    views = System.Linq.Enumerable.ToArray(System.Linq.Enumerable.Select(views, v => v.name)), skinnedCopies = copies.Count, weapons = weapons.Count,
    springs = simulate ? springs.Length : 0, travelMetresPerTick = travel,
    renderPipeline = UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline != null ? UnityEngine.Rendering.GraphicsSettings.currentRenderPipeline.name : "built-in",
    seconds = (System.DateTime.UtcNow - started).TotalSeconds };
  System.IO.File.WriteAllText(output, Newtonsoft.Json.JsonConvert.SerializeObject(data, Newtonsoft.Json.Formatting.Indented));
  return new { output, clips = receipts.Count, data.views, data.seconds };
} finally {
  UnityEngine.RenderTexture.active = previousActive;
  for (int i = temporary.Count - 1; i >= 0; i--) if (temporary[i] != null) UnityEngine.Object.DestroyImmediate(temporary[i]);
  UnityEditor.SceneManagement.EditorSceneManager.ClosePreviewScene(scene);
}
