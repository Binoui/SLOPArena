<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck" Version="3.6.0" />
    <PackageReference Include="FsCheck.Xunit" Version="3.6.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Shared\SlopArena.Shared.csproj" />
    <ProjectReference Include="../../tools/ReplayReport/ReplayReport.csproj" />
    <ProjectReference Include="../../tools/KitCheck/KitCheck.csproj" />
    <ProjectReference Include="..\..\tools\MoveDataReport\MoveDataReport.csproj" />
    <ProjectReference Include="..\..\tools\AssetCatalog\AssetCatalog.csproj" />
    <ProjectReference Include="..\..\tools\SessionLogReport\SessionLogReport.csproj" />
    <ProjectReference Include="..\..\tools\HitReliabilityReport\HitReliabilityReport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Combat tuning is match-owned; collections can run concurrently. Bound worker count
         so hosts with many cores do not start hundreds of content-loading tests at once. -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Fixtures/FightGuyAuthoring/cooked.expected.hex" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Workshop/ModelSwapChoice.cs" Link="Workshop/ModelSwapChoice.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Workshop/ModelSwapChoiceSources.cs" Link="Workshop/ModelSwapChoiceSources.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Workshop/ModelSwapSession.cs" Link="Workshop/ModelSwapSession.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Workshop/WorkshopLibrary.cs" Link="Workshop/WorkshopLibrary.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Workshop/ModelSwapBases.cs" Link="Workshop/ModelSwapBases.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Workshop/FighterRevisionSet.cs" Link="Workshop/FighterRevisionSet.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Workshop/WorkshopPublishEdits.cs" Link="Workshop/WorkshopPublishEdits.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/UI/UiModalState.cs" Link="UI/UiModalState.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/UI/LocalFighterLibrary.Content.cs" Link="UI/LocalFighterLibrary.Content.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/UI/FighterChoiceState.cs" Link="UI/FighterChoiceState.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Simulation/LocalSimulationBridge.cs" Link="Simulation/LocalSimulationBridge.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/Simulation/ISimulationBridge.cs" Link="Simulation/ISimulationBridge.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/UI/MatchConfig.cs" Link="UI/MatchConfig.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/UI/LegacyFighterSelection.cs" Link="UI/LegacyFighterSelection.cs" />
    <Compile Include="../../client/Unity/Assets/Scripts/Runtime/UI/MenuChoice.cs" Link="UI/MenuChoice.cs" />
  </ItemGroup>
</Project>
